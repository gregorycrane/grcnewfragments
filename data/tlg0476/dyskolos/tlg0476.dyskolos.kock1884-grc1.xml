  <text xml:base="urn:cts:greekLit:tlg0476.dyskolos.kock1884-grc1" xml:lang="grc"><body n="urn:cts:greekLit:tlg0476.dyskolos.kock1884-grc1" xml:lang="grc"><div type="edition" n="urn:cts:greekLit:tlg0476.dyskolos.kock1884-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0476_dyskolos"><head>ΔΥΣΚΟΛΟΣ</head><div type="textpart" subtype="fragment" n="3" xml:id="kock-0476-dyskolos-3" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0476_dyskolos">
              <lg>
                <l n="1" xml:id="kock-0476-dyskolos-3-l1" xml:lang="grc">ἀλλ’ ἀντιβολῶ σ’ ἐπίταττέ μοι μὴ πόλλ’ ἄγαν,</l>
                <l n="2" xml:id="kock-0476-dyskolos-3-l2" xml:lang="grc">μηδ’ ἄγρια λίαν μηδ’ ἐπηργυρωμένα,</l>
                <l n="3" xml:id="kock-0476-dyskolos-3-l3" xml:lang="grc">μέτρια δέ γ’ ὡς θείῳ σεαυτοῦ. Β. πῶς ἔτι</l>
                <l n="4" xml:id="kock-0476-dyskolos-3-l4" xml:lang="grc">μετριώτερ’, ὦ δαιμόνι’; Α. ὅπως; σύντεμνε καὶ</l>
                <l n="5" xml:id="kock-0476-dyskolos-3-l5" xml:lang="grc">ἐπεξαπάτα με. τοὺς μὲν ἰχθῦς μοι κάλει</l>
                <l n="6" xml:id="kock-0476-dyskolos-3-l6" xml:lang="grc">ἰχθύδι’· ὄψον δ’ ἂν λέγῃς ἕτερον, κάλει</l>
                <l n="7" xml:id="kock-0476-dyskolos-3-l7" xml:lang="grc">ὀψάριον. ἥδιον γὰρ ἀπολοῦμαι πολύ.</l>
              </lg>
            </div>
          </div></body></text></TEI>
