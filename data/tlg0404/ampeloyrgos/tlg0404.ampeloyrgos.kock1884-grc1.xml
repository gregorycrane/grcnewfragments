  <text xml:base="urn:cts:greekLit:tlg0404.ampeloyrgos.kock1884-grc1" xml:lang="grc"><body n="urn:cts:greekLit:tlg0404.ampeloyrgos.kock1884-grc1" xml:lang="grc"><div type="edition" n="urn:cts:greekLit:tlg0404.ampeloyrgos.kock1884-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0404_ampeloyrgos"><head>ΑΜΠΕΛΟΥΡΓΟΣ</head><div type="textpart" subtype="fragment" n="3" xml:id="kock-0404-ampeloyrgos-3" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0404_ampeloyrgos">
              <lg>
                <l n="1" xml:id="kock-0404-ampeloyrgos-3-l1" xml:lang="grc">οὐκ ἔστιν οὐδὲν ἀτυχίας ἀνθρωπίνης</l>
                <l n="2" xml:id="kock-0404-ampeloyrgos-3-l2" xml:lang="grc">παραμύθιον γλυκύτερον ἐν βίῳ τέχνης·</l>
                <l n="3" xml:id="kock-0404-ampeloyrgos-3-l3" xml:lang="grc">ἐπὶ τοῦ μαθήματος γὰρ ἑστηκὼς ὁ νοῦς</l>
                <l n="4" xml:id="kock-0404-ampeloyrgos-3-l4" xml:lang="grc">αὑτὸν λέληθε παραπλέων τὰς συμφοράς.</l>
              </lg>
              <note type="source">Stobaeus Floril. 60, 1 Ἀμφιδος ἐξ Ἀμπελουργοῦ Α.</note>
              <note type="apparatus">4. αὑτὸν Mein.] αὐτοῦ. παραπλέων Trinc. Gesn. 1] παραπλέον. scientia quasi navis est, qua homo calamitates tamquam cautes praetervehitur.</note>
            </div>
            <div type="textpart" subtype="fragment" n="4" xml:id="kock-0404-ampeloyrgos-4" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0404_ampeloyrgos">
              <lg>
                <l n="1" xml:id="kock-0404-ampeloyrgos-4-l1" xml:lang="grc">ἐν οἷς ἂν ἀτυχήσῃ τις ἄνθρωπος τόποις,</l>
                <l n="2" xml:id="kock-0404-ampeloyrgos-4-l2" xml:lang="grc">ἥκιστα τούτοις πλησιάζων ἥδεται.</l>
              </lg>
              <note type="source">Stobaeus Floril. 104, 6 Ἀμφιδος ἐξ Ἀμπελουργοῦ Α.</note>
              <note type="apparatus">‘Phaedrus nemo libenter recolit qui laesit locum’. Valcken.</note>
            </div>
            <div type="textpart" subtype="fragment" n="5" xml:id="kock-0404-ampeloyrgos-5" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0404_ampeloyrgos">
              <lg>
                <l n="1" xml:id="kock-0404-ampeloyrgos-5-l1" xml:lang="grc">μικρόν τι κέρμα</l>
              </lg>
              <note type="source">ὥσπερ ἐν τῷ Ἀμφιδος Ἀμπελουργῷ. Pollux 9, 88. idem 7, 170 κέρμα ἑνικῶς Ἄμφις εἴρηκεν ἐν Ἀμπελουργῷ. cf. Antiphan. 131.</note>
              <note type="apparatus">scilicet multo frequentius numero plurali.</note>
            </div>
          </div></body></text></TEI>
