  <text xml:base="urn:cts:greekLit:tlg0404.philadelphoi.meineke1840-grc1" xml:lang="grc"><body n="urn:cts:greekLit:tlg0404.philadelphoi.meineke1840-grc1" xml:lang="grc"><div type="edition" n="urn:cts:greekLit:tlg0404.philadelphoi.meineke1840-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0404_philadelphoi"><head>ΦΙΛΑΔΕΛΦΟΙ</head><pb n="680" facs="urn:hathi:hvd.32044079388682:scan:682" />
            <div type="textpart" subtype="fragment" n="1" ana="#compiled-citation-normalized" xml:id="meineke-0404-philadelphoi-1">
              <head>I.</head>
              <quote>
                <lg>
                  <l n="1" xml:id="meineke-0404-philadelphoi-1-l1">Mihi equidem multis partibus laudatior</l>
                  <l n="2" xml:id="meineke-0404-philadelphoi-1-l2">merobibulorum vita, quam vestrum, quibus</l>
                  <l n="3" xml:id="meineke-0404-philadelphoi-1-l3">sapientia omnis fronte caperata sedet.</l>
                  <l n="4" xml:id="meineke-0404-philadelphoi-1-l4">nam digerendis rebus quae prudentia</l>
                  <l n="5" xml:id="meineke-0404-philadelphoi-1-l5">perpetuo invigilat, quia minutim atque anxie</l>
                  <l n="6" xml:id="meineke-0404-philadelphoi-1-l6">momenta explorat, aggredi negotia</l>
                  <l n="7" xml:id="meineke-0404-philadelphoi-1-l7">cunctatur: illa vero quae non deputat</l>
                  <l n="8" xml:id="meineke-0404-philadelphoi-1-l8">tam pensiculate quid sit consectarium</l>
                  <l n="9" xml:id="meineke-0404-philadelphoi-1-l9">ad quamque rem, calidius et iuvenilius</l>
                  <l n="10" xml:id="meineke-0404-philadelphoi-1-l10">molitur aliquid.</l>
                </lg>
              </quote>
            </div>
            <pb n="316" facs="urn:hathi:hvd.32044079388682:scan:324" />
            <div type="textpart" subtype="fragment" n="2" ana="#compiled-citation-normalized" xml:id="meineke-0404-philadelphoi-2">
              <head>II.</head>
              <quote>
                <lg>
                  <l n="1" xml:id="meineke-0404-philadelphoi-2-l1">Ἄπολλον, ὡς δυσάρεστόν ἐστ’ ἀνιώμενος</l>
                  <l n="2" xml:id="meineke-0404-philadelphoi-2-l2">ἄνθρωπος ἐφ’ ἅπασίν τε δυσχερῶς ἔχει.</l>
                </lg>
              </quote>
              <note type="source">Stobaeus Floril. XCIX 24 cum lemmate Ἄμφιδος Φιλαδέλφων.</note>
            </div>
            <pb n="680" facs="urn:hathi:hvd.32044079388682:scan:682" />
            <div type="textpart" subtype="fragment" n="2_2" ana="#compiled-duplicate-number #compiled-citation-normalized" xml:id="meineke-0404-philadelphoi-2_2">
              <head>II.</head>
              <quote>
                <lg>
                  <l n="1" xml:id="meineke-0404-philadelphoi-2_2-l1">Quam res morosa est, summe divum Iuppiter,</l>
                  <l n="2" xml:id="meineke-0404-philadelphoi-2_2-l2">homo tristis! et cuncta in malam partem accipit.</l>
                </lg>
              </quote>
            </div>
