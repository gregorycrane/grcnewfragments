    <body n="urn:cts:greekLit:tlg0541.gnomai.meineke1841-grc1" xml:lang="grc">
      <div type="edition" n="urn:cts:greekLit:tlg0541.gnomai.meineke1841-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0541_gnomai">
        <head>ΓΝΩΜΑΙ</head>
        <div type="textpart" subtype="fragment" n="1" xml:id="meineke-0541-gnomai-1">
          <head>ΜΕΝΑΝΔΡΟΣ.</head>
          <lg>
            <l n="1" xml:id="meineke-0541-gnomai-1-l1">Πολλῶν ὁ καιρὸς γίνεται παραίτιος·</l>
            <l n="2" xml:id="meineke-0541-gnomai-1-l2">ἂν γὰρ μέγιστα κομπάσῃς φρονῶν μέγα,</l>
            <l n="3" xml:id="meineke-0541-gnomai-1-l3">οὐκ οἶδας ὡς πολλὰς μεταβολὰς ἔχει.</l>
            <l n="4" xml:id="meineke-0541-gnomai-1-l4">ὃ νῦν δίδωσιν, οὐ δίδωσιν αὔριον.</l>
          </lg>
        </div>
        <div type="textpart" subtype="fragment" n="2" xml:id="meineke-0541-gnomai-2">
          <head>ΜΕΝΑΝΔΡΟΣ.</head>
          <lg>
            <l n="5" xml:id="meineke-0541-gnomai-2-l5">Χρόνος γὰρ οὗτός ἐστιν ἀνθρώποις ἀεί.</l>
            <l n="6" xml:id="meineke-0541-gnomai-2-l6">τὸν οὖν παρόντα καιρὸν ἀπάνταν ἀφεῖς</l>
            <l n="7" xml:id="meineke-0541-gnomai-2-l7">οὐκ ἔστιν αὐτὸν προσλαβεῖν πάλιν ταχύ.</l>
          </lg>
        </div>
      </div>
    </body>
