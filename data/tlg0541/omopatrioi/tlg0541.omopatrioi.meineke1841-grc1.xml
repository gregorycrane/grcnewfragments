      <div type="edition" n="urn:cts:greekLit:tlg0541.omopatrioi.meineke1841-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0541_omopatrioi">
        <head>ΟΜΟΠΑΤΡΙΟΙ</head>
        <pb n="178" facs="urn:hathi:hvd.32044098646714:scan:202" />
        <div type="textpart" subtype="fragment" n="1" ana="#compiled-citation-normalized" xml:id="meineke-0541-omopatrioi-1">
          <head type="fragment-number">I.</head>
          <lg>
            <l n="1" xml:id="meineke-0541-omopatrioi-1-l1">Ἅπας ἐρυθριῶν χρηστὸς εἶναί μοι δοκεῖ.</l>
          </lg>
          <note type="source">Stobaeus Flor. XXXI 5.</note>
          <note type="apparatus">Scripsi ἅπας praeeunte Grotio pro πᾶς.</note>
        </div>
        <pb n="768" facs="urn:hathi:hvd.32044098646714:scan:794" />
        <div type="textpart" subtype="fragment" n="1_2" ana="#compiled-duplicate-number #compiled-citation-normalized" xml:id="meineke-0541-omopatrioi-1_2">
          <head>I.</head>
          <lg>
            <l n="1" xml:id="meineke-0541-omopatrioi-1_2-l1">Me iudice, qui erubescit ingenio est probo.</l>
          </lg>
        </div>
        <pb n="178" facs="urn:hathi:hvd.32044098646714:scan:202" />
        <div type="textpart" subtype="fragment" n="2" ana="#compiled-citation-normalized" xml:id="meineke-0541-omopatrioi-2">
          <head type="fragment-number">II.</head>
          <lg>
            <l n="1" xml:id="meineke-0541-omopatrioi-2-l1">Χρηστοὺς νομιζομένους ἐφόδιον ἀσφαλές</l>
            <l n="2" xml:id="meineke-0541-omopatrioi-2-l2">εἰς πάντα καιρὸν καὶ τύχης πᾶσαν ῥοπήν.</l>
          </lg>
          <note type="source">Stobaeus Flor. XXXVI 10.</note>
          <note type="apparatus">Grotius χρηστοῖς νομιζομένοις. Sed vide Bentleium. Vs. 2 ante Grotium ῥοπὴν πᾶσαν.</note>
        </div>
        <pb n="768" facs="urn:hathi:hvd.32044098646714:scan:794" />
        <div type="textpart" subtype="fragment" n="2_2" ana="#compiled-duplicate-number #compiled-citation-normalized" xml:id="meineke-0541-omopatrioi-2_2">
          <head>II.</head>
          <lg>
            <l n="1" xml:id="meineke-0541-omopatrioi-2_2-l1">Bono esse nomine, id vero viaticum est,</l>
            <l n="2" xml:id="meineke-0541-omopatrioi-2_2-l2">quidquid paret fortuna quovis tempore.</l>
          </lg>
        </div>
        <pb n="178" facs="urn:hathi:hvd.32044098646714:scan:202" />
        <div type="textpart" subtype="fragment" n="3" ana="#compiled-citation-normalized" xml:id="meineke-0541-omopatrioi-3">
          <head type="fragment-number">III.</head>
          <note type="source">Suidas, Ἀλφάνει: εὑρίσκει. Μένανδρος Ὁμοπατρίοις</note>
          <quote>
            <lg>
              <l n="1" xml:id="meineke-0541-omopatrioi-3-l1">Ἦν δῆλον οὔ τι νυμφίος τε ἀλφάνει.</l>
            </lg>
          </quote>
          <note type="apparatus">Duo libri ἣν et οὔνι. Bentleius ἣν δηλονοτιὴ νυμφίος τότ᾽ ἀλφάνει.</note>
        </div>
      </div>
