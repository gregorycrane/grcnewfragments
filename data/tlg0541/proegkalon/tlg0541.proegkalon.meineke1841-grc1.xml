    <body n="urn:cts:greekLit:tlg0541.proegkalon.meineke1841-grc1" xml:lang="grc">
      <div type="edition" n="urn:cts:greekLit:tlg0541.proegkalon.meineke1841-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0541_proegkalon">
        <head>ΠΡΟΕΓΚΑΛΩΝ</head>
        <pb n="196" facs="urn:hathi:hvd.32044098646714:scan:220" />
        <div type="textpart" subtype="fragment" n="1" ana="#compiled-citation-normalized" xml:id="meineke-0541-proegkalon-1">
          <head>I.</head>
          <lg>
            <l n="1" xml:id="meineke-0541-proegkalon-1-l1">Τὸ δ᾽ εὖ</l>
            <l n="2" xml:id="meineke-0541-proegkalon-1-l2">κελευόμενον μέν ἐστιν ἀσφαλέστατον</l>
            <l n="3" xml:id="meineke-0541-proegkalon-1-l3">δοῦλον ποιεῖν, ὡς φασι.</l>
          </lg>
          <note type="source">Stobaeus Flor. LXII 17.</note>
          <note type="apparatus">Versu tertio libri δουλοποιεῖν. Correxit Erfurdtius Obs. in Athen. p. 17. Grotius δούλῳ ποιεῖν.</note>
        </div>
        <div type="textpart" subtype="fragment" n="1_2" ana="#compiled-duplicate-number #compiled-citation-normalized" xml:id="meineke-0541-proegkalon-1_2">
          <head rend="align(center)">I.</head>
          <quote>
            <lg>
              <l n="1" xml:id="meineke-0541-proegkalon-1_2-l1">Quod bene iubetur exsequi tutissimum</l>
              <l n="2" xml:id="meineke-0541-proegkalon-1_2-l2">servo esse praedicant.</l>
            </lg>
          </quote>
        </div>
        <div type="textpart" subtype="fragment" n="2" ana="#compiled-citation-normalized" xml:id="meineke-0541-proegkalon-2">
          <head>II.</head>
          <lg>
            <l n="1" xml:id="meineke-0541-proegkalon-2-l1">Οἷον τὸ γενέσθαι πατέρα παίδων ἦν ἄρα·</l>
            <l n="2" xml:id="meineke-0541-proegkalon-2-l2">λύπη, φόβος, φροντίς, πέρας ἐστὶν οὐδὲ ἕν.</l>
          </lg>
          <note type="source">Stobaeus Flor. LXXVI 8.</note>
          <note type="apparatus">Primo versu addidi ἄρα. Vide edit. mai. Bentleius κακόν, quod sequutus est Gaisfordus.</note>
        </div>
        <div type="textpart" subtype="fragment" n="2_2" ana="#compiled-duplicate-number #compiled-citation-normalized" xml:id="meineke-0541-proegkalon-2_2">
          <head rend="align(center)">II.</head>
          <quote>
            <lg>
              <l n="1" xml:id="meineke-0541-proegkalon-2_2-l1">Patrem vocari liberûm quantum est! metus,</l>
              <l n="2" xml:id="meineke-0541-proegkalon-2_2-l2">dolorque et aegritudo, sine fine ac modo.</l>
            </lg>
          </quote>
        </div>
      </div>
    </body>
