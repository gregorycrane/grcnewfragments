    <body n="urn:cts:greekLit:tlg0500.myrmex.meineke1841-grc1" xml:lang="grc">
      <div type="edition" n="urn:cts:greekLit:tlg0500.myrmex.meineke1841-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0500_myrmex">
        <head>ΜΥΡΜΗΞ</head>
        <div type="textpart" subtype="fragment" n="1" xml:id="meineke-0500-myrmex-1">
          <head>1.</head>
          <quote>
            <lg>
              <l n="1" xml:id="meineke-0500-myrmex-1-l1">Res inter omnes quas Deos exposcimus</l>
              <l n="2" xml:id="meineke-0500-myrmex-1-l2">locum meretur principem immortalitas.</l>
            </lg>
          </quote>
        </div>
        <div type="textpart" subtype="fragment" n="1_2" ana="#compiled-duplicate-number #compiled-citation-normalized" xml:id="meineke-0500-myrmex-1_2">
          <head>I.</head>
          <quote>
            <lg>
              <l n="1" xml:id="meineke-0500-myrmex-1_2-l1">Ὧν τοῖς θεοῖς ἄνθρωπος εὔχεται τυχεῖν</l>
              <l n="2" xml:id="meineke-0500-myrmex-1_2-l2">τῆς εὐθανασίας κρεῖττον οὐδὲν εὔχεται.</l>
            </lg>
          </quote>
          <note type="source">
            <bibl>Stobaeus Flor. CXVIII 17:</bibl>
            <quote>Ποσειδίππου ἐκ Μύρμηκος.</quote>
          </note>
          <note type="apparatus">Vs. 2 εὐθανασίας cod. A. ἀθανασίας vulgo.</note>
        </div>
        <div type="textpart" subtype="fragment" n="2" ana="#compiled-citation-normalized" xml:id="meineke-0500-myrmex-2">
          <head>II.</head>
          <quote>
            <lg>
              <l n="1" xml:id="meineke-0500-myrmex-2-l1">Οὕτω τι πολύπουν ἐστὶν ἡ λύπη κακόν.</l>
            </lg>
          </quote>
          <note type="source">
            <bibl>Stobaeus Flor. XCIX 29:</bibl>
            <quote>Ποσειδίππου ἐκ Μύρμηκος.</quote>
          </note>
          <note type="apparatus">Pro τι cod. A τοι.</note>
        </div>
      </div>
