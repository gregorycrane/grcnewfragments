  <text xml:base="urn:cts:greekLit:tlg0515.konisalos.meineke1840-grc1" xml:lang="grc"><body n="urn:cts:greekLit:tlg0515.konisalos.meineke1840-grc1" xml:lang="grc"><div type="edition" n="urn:cts:greekLit:tlg0515.konisalos.meineke1840-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0515_konisalos"><head>ΚΟΝΙΣΑΛΟΣ</head><div type="textpart" subtype="fragment" n="konisalos" author_heading="TIMOCLES" work_heading="ΚΟΝΙΣΑΛΟΣ" ana="#compiled-citation-normalized" xml:id="meineke-0515-konisalos-konisalos">
              <lg>
                <l n="1" xml:id="meineke-0515-konisalos-konisalos-l1">Potans par pari urgebo virum</l>
                <l n="2" xml:id="meineke-0515-konisalos-konisalos-l2">magnis culullis verum ut omne enuntiet.</l>
              </lg>
            </div>
            <div type="textpart" subtype="fragment" n="unnumbered" xml:id="meineke-0515-konisalos-unnumbered">
              <lg>
                <l n="1" xml:id="meineke-0515-konisalos-unnumbered-l1">Πατάξω τ᾽ ἴσον ἴσῳ ποτηρίοις</l>
                <l n="2" xml:id="meineke-0515-konisalos-unnumbered-l2">μεγάλοις ἅπασαν τὴν ἀλήθειαν φράσαι.</l>
              </lg>
              <note type="source">Athenaeus X p. 430 f. de variis vini miscendi generibus disserens: ἴσον ἴσῳ δὲ Τιμοκλῆς ἐν Κονισάλῳ Πατάξω κτλ.</note>
              <note type="apparatus">Dindorfius coniiciebat παταξάτω τις ἴσον. Formula ἴσον ἴσῳ absolute utitur etiam Sophilus Enchir. p. 581. συνεχὴς ἄκρατος ἐδίδοτ᾽ ἴσον ἴσῳ. Et sic passim. De πατάσσειν ποτηρίοις dixi ad Eubuli inc. fab. VI 3.</note>
            </div>
          </div></body></text></TEI>