  <text xml:base="urn:cts:greekLit:tlg0515.lethe.kock1884-grc1" xml:lang="grc"><body n="urn:cts:greekLit:tlg0515.lethe.kock1884-grc1" xml:lang="grc"><div type="edition" n="urn:cts:greekLit:tlg0515.lethe.kock1884-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0515_lethe"><head>ΛΗΘΗ</head><div type="textpart" subtype="fragment" n="21" xml:id="kock-0515-lethe-21" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0515_lethe">
              <lg>
                <l n="1" xml:id="kock-0515-lethe-21-l1" xml:lang="grc">μετὰ τοῦτον αὐτῷ Τηλέμαχος συνετύγχανεν.</l>
                <l n="2" xml:id="kock-0515-lethe-21-l2" xml:lang="grc">καὶ τοῦτον ἀσπασάμενος ἡδέως πάνυ</l>
                <l n="3" xml:id="kock-0515-lethe-21-l3" xml:lang="grc">ἔπειτα ‘χρῆσόν μοι σύ, φησί, τὰς χύτρας</l>
                <l n="4" xml:id="kock-0515-lethe-21-l4" xml:lang="grc">ἐν αἶσιν ἥψες τοὺς κυάμους.’ καὶ ταῦτά τε</l>
                <l n="5" xml:id="kock-0515-lethe-21-l5" xml:lang="grc">εἴρητο καὶ παριόντα Φείδιππον πάνυ</l>
                <l n="6" xml:id="kock-0515-lethe-21-l6" xml:lang="grc">τὸν Χαιρεφίλου πόρρωθεν ἀπιδὼν τὸν παχὺν</l>
                <l n="7" xml:id="kock-0515-lethe-21-l7" xml:lang="grc">ἐπόππυσ’, εἶτ’ ἐκέλευσε πέμπειν σαργάνας.</l>
              </lg>
              <note type="source">Athenaeus 9, 407 d <foreign xml:lang="grc">Τιμοκλῆς ... ἐν δράματι Λήθη φησί κτλ</foreign>.</note>
              <note type="apparatus">4. <foreign xml:lang="grc">αἶσιν ἦψες</foreign> (<foreign xml:lang="grc">ἕψεις</foreign> in Ath.) Mein.] <foreign xml:lang="grc">αἷς συνῆψας</foreign> A. 5. <foreign xml:lang="grc">εἴρητο</foreign> Pors.] <foreign xml:lang="grc">εἴρηται</foreign> A. <foreign xml:lang="grc">Φείδιππον</foreign> Pors.] <foreign xml:lang="grc">φίλιππον</foreign> A. <foreign xml:lang="grc">πάνυ</foreign>] <foreign xml:lang="grc">πάλιν</foreign> Mein. <foreign xml:lang="grc">πάνυ</foreign> coniungendum cum <foreign xml:lang="grc">πόρρωθεν</foreign>. — cf. Alexid. 6. 218. extrema non magis intellego quam fr. 14, 4.</note>
            </div>
