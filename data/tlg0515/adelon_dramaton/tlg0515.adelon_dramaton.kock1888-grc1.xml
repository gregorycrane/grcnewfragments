        </div>
        <div type="textpart" subtype="fragment" n="22" xml:id="kock-0515-adelon_dramaton-22" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0515_adelon_dramaton">
          <note type="apparatus">22, 3. 'nec obliviscendae sunt lucernae partes in re venerea apud veteres' χρῶμα defendens Herwerd. 192.</note>
        </div>
        <div type="textpart" subtype="fragment" n="35" xml:id="kock-0515-adelon_dramaton-35" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0515_adelon_dramaton">
