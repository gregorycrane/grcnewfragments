  <text xml:lang="grc"><body xml:base="urn:cts:greekLit:tlg0006.peleys.dindorf1893-grc1"><div type="edition" n="urn:cts:greekLit:tlg0006.peleys.dindorf1893-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_peleys"><head>ΠΗΛΕΥΣ</head><div type="textpart" subtype="fragment" n="1" xml:id="fragment-peleys-dindorf1893_grc1-1" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_peleys" sameAs="urn:cts:greekLit:tlg0006.peleys.nauck1889grc1:623">
            <note type="source">1. Aristoph. Nub. 1153.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Βοάσομαι τἄρα τὰν ὑπέρτονον</l>
              <l n="2" xml:lang="grc">βοάν.</l>
            </lg>
            <note type="commentary">ubi Schol. παρὰ τὰ ἐκ Πηλέως Εὐριπίδου (Σοφοκλέους. cod. Ven., in quo tamen reliqua desunt.) ἐπιφέρει γὰρ</note>
            <lg type="fragment">
              <l n="3" xml:lang="grc">ἰὼ, πύλαισιν ἤ τις ἐν δόμοις.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="2" xml:id="fragment-peleys-dindorf1893_grc1-2" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_peleys" sameAs="urn:cts:greekLit:tlg0006.peleys.nauck1889grc1:620">
            <note type="source">2. Stobæus Ecl. Phys. I, 6, 10, p. 170 ed. Heer.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Κλύετ᾽ ὦ Μοίραι, Διὸς αἵτε παρὰ</l>
              <l n="2" xml:lang="grc">θρόνον ἀγχόταται θεῶν ἑζόμεναι.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="3" xml:id="fragment-peleys-dindorf1893_grc1-3" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_peleys" sameAs="urn:cts:greekLit:tlg0006.peleys.nauck1889grc1:617">
            <note type="source">3. Stobæus XC, 7.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Οὐκ ἔστιν ἀνθρώποισι τοιοῦτο σκότος,</l>
              <l n="2" xml:lang="grc">οὐ δῶμα γαίας κλειστὸν, ἔνθα τὴν φύσιν</l>
              <l n="3" xml:lang="grc">ὁ δυσγενὴς κρύψας ἂν * εἴη σοφός.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="4" xml:id="fragment-peleys-dindorf1893_grc1-4" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_peleys" sameAs="urn:cts:greekLit:tlg0006.peleys.nauck1889grc1:618">
            <note type="source">4. Stobæus XCIII, 10.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Τὸν ὄλβον οὐδὲν οὐδαμοῦ κρίνω βροτοίς,</l>
              <l n="2" xml:lang="grc">ὃν γ᾽ ἐξαλείφει ῥᾷον, ἢ γράφει, θεός.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="5" xml:id="fragment-peleys-dindorf1893_grc1-5" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_peleys" sameAs="urn:cts:greekLit:tlg0006.peleys.nauck1889grc1:619">
            <note type="source">5. Stobæus CXV, 6.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Τὸ γῆρας, ὦ παῖ, τῶν νεωτέρων φρενῶν</l>
              <l n="2" xml:lang="grc">σοφώτερον πέφυκε κἀσφαλέστερον,</l>
              <l n="3" xml:lang="grc">ἐμπειρία τε τῆς ἀπειρίας κρατεῖ.</l>
            </lg>
          </div>
        <div type="textpart" subtype="fragment" n="6" xml:id="fragment-peleys-dindorf1893_grc1-6" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_peleys" sameAs="urn:cts:greekLit:tlg0006.peleys.nauck1889grc1:621">
            <note type="source">6. Jo. Laurent. Lyd. de magistr. III, 25, p. 192:</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">τὰ δ᾽ ἔνθεν οὐκέτ᾽ ἂν φράσαι λόγῳ</l>
              <l n="2" xml:lang="grc">δακρύων δυναίμην χωρίς —</l>
            </lg>
          </div>
          </div></body></text></TEI>
