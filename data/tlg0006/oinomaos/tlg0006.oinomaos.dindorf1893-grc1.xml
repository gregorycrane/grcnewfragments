  <text xml:lang="grc"><body xml:base="urn:cts:greekLit:tlg0006.oinomaos.dindorf1893-grc1"><div type="edition" n="urn:cts:greekLit:tlg0006.oinomaos.dindorf1893-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_oinomaos"><head>ΟΙΝΟΜΑΟΣ</head><div type="textpart" subtype="fragment" n="1" xml:id="fragment-oinomaos-dindorf1893_grc1-1" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_oinomaos" sameAs="urn:cts:greekLit:tlg0006.oinomaos.nauck1889grc1:571">
            <note type="source">1. Stobæus LXXVI, 2.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ἀμηχανῶ δ᾽ ἔγωγε κοὐκ ἔχω μαθεῖν,</l>
              <l n="2" xml:lang="grc">εἴτ᾽ οὖν ἄμεινόν ἐστι γίγνεσθαι τέκνα</l>
              <l n="3" xml:lang="grc">θνητοῖσιν, εἴτ᾿ ἄπαιδα καρποῦσθαι βίον.</l>
              <l n="4" xml:lang="grc">ὁρῶ γὰρ, οἷς μὲν οὐκ ἔφυσαν, ἀθλίους,</l>
              <l n="5" xml:lang="grc">ὅσοισι δ᾽ εἰσὶν, οὐδὲν εὐτυχεστέρους.</l>
              <l n="6" xml:lang="grc">καὶ γὰρ κακοὶ γεγῶτες ἐχθίστη νόσος,</l>
              <l n="7" xml:lang="grc">κἂν αὖ γένωνται σώφρονες, κακὸν μέγα</l>
              <l n="8" xml:lang="grc">λυποῦσι τὸν φύσαντα, μὴ πάθωσί τι.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="2" xml:id="fragment-oinomaos-dindorf1893_grc1-2" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_oinomaos" sameAs="urn:cts:greekLit:tlg0006.oinomaos.nauck1889grc1:576">
            <note type="source">2. Stobæus LVIII, 5.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ὁ πλεῖστα πράσσων πλεῖσθ᾽ ἁμαρτάνει βροτῶν.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="3" xml:id="fragment-oinomaos-dindorf1893_grc1-3" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_oinomaos" sameAs="urn:cts:greekLit:tlg0006.oinomaos.nauck1889grc1:577">
            <note type="source">3. Orion. Anthologn. V, 5, p. 47 ed. Schneidew.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ἐγὼ μὲν, εὐτ᾿ ἂν τοὺς κακοὺς ὁρῶ βροτῶν</l>
              <l n="2" xml:lang="grc">πίπτοντας, εἶναί φημι δαιμόνων γένος.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="4" xml:id="fragment-oinomaos-dindorf1893_grc1-4" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_oinomaos" sameAs="urn:cts:greekLit:tlg0006.oinomaos.nauck1889grc1:572">
            <note type="source">4. Stobæus XCIX, 8.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">ὧν ἐστι πάντων πρῶτον εἰδέναι τόδε,</l>
              <l n="2" xml:lang="grc">φέρειν τὰ συμπίπτοντα μὴ παλιγκότως.</l>
              <l n="3" xml:lang="grc">χοὐτός γ᾽ ἀνὴρ ἄριστος, αἵ τε συμφοραὶ</l>
              <l n="4" xml:lang="grc">ἧσσον δάκνουσιν' ἀλλὰ ταῦτα γὰρ λέγειν</l>
              <l n="5" xml:lang="grc">ἐπιστάμεσθα, δρᾶν δ᾽ ἀμηχανῶς ἔχει.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="5" xml:id="fragment-oinomaos-dindorf1893_grc1-5" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_oinomaos" sameAs="urn:cts:greekLit:tlg0006.oinomaos.nauck1889grc1:575">
            <note type="source">5. Stobæus CXVI, 5.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ὅστις δὲ θνητῶν βούλεται δυσώνυμον</l>
              <l n="2" xml:lang="grc">εἰς γῆρας ἐλθεῖν, οὐ λογίζεται καλῶς.</l>
              <l n="3" xml:lang="grc">μακρὸς γὰρ αἰὼν μυρίους τίκτει πόνους.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="6" xml:id="fragment-oinomaos-dindorf1893_grc1-6" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_oinomaos" sameAs="urn:cts:greekLit:tlg0006.oinomaos.nauck1889grc1:573">
            <note type="source">6. Stobæus CXXII, 8.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ἀλλ᾽ ἔστι γὰρ δὴ κὰν κακοῖσιν ἡδονὴ</l>
              <l n="2" xml:lang="grc">θνητοῖς, ὀδυρμοὶ δακρύων τ᾽ ἐπιρροαί.</l>
              <l n="3" xml:lang="grc">ἀλγηδόνας δὲ ταῦτα κουφίζει φρενῶν</l>
              <l n="4" xml:lang="grc">καὶ καρδίας ἔλυσε τοὺς ἄγαν πόνους.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="7" xml:id="fragment-oinomaos-dindorf1893_grc1-7" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_oinomaos" sameAs="urn:cts:greekLit:tlg0006.oinomaos.nauck1889grc1:574">
            <note type="source">7. Clem. Alex. Strom. VI, 2, § 18, p. 746 Ρ. Εὐριπίδου ἐν μὲν τῷ Οἰνομάῳ γράφοντος·</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">τεκμαιρόμεσθα τοῖς παροῦσι τἀφανῆ.</l>
            </lg>
          </div>
        </div></body></text></TEI>
