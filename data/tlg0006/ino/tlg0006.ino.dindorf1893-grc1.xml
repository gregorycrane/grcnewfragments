  <text xml:lang="grc"><body xml:base="urn:cts:greekLit:tlg0006.ino.dindorf1893-grc1"><div type="edition" n="urn:cts:greekLit:tlg0006.ino.dindorf1893-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino"><head>ΙΝΩ</head><div type="textpart" subtype="fragment" n="1" xml:id="fragment-ino-dindorf1893_grc1-1" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:398">
            <note type="source">1. Schol. Pind. Isth. IV, 39 ad verba poetæ:—ἐν ὕπνῳ γὰρ πέσεν· ἀλλ᾽ ἀνεγειρομένα χρῶτα λάμπει adscribit: τῷ αὐτῷ τρόπῳ καὶ Εὐριπίδης κέχρηται</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ἰδοῦσα δ᾽ Ἰνοῦς συμφορὰν πολὺν χρόνον</l>
              <l n="2" xml:lang="grc">νῦν ὄμμ᾽ ἐγείρει.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="2" xml:id="fragment-ino-dindorf1893_grc1-2" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:404">
            <note type="source">2. Stobæus LXXXVIII, 9.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">τό τ᾽ εὐγενὲς</l>
              <l n="2" xml:lang="grc">πολλὴν δίδωσιν ἐλπίδ᾽, ὡς ἄρξουσι γῆς.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="3" xml:id="fragment-ino-dindorf1893_grc1-3" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino">
            <note type="source">3. Stobus LXXXVIII, 10.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Τὴν εὐγένειαν κἂν ἄμορφος ᾖ γάμος,</l>
            </lg>
          </div>
        <div type="textpart" subtype="fragment" n="4" xml:id="fragment-ino-dindorf1893_grc1-4" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:399">
            <note type="source">4. Plut. de sera num. vind. 11, (p. 556 Α.) Ὥσπερ τῆς Ἰνοῦς ἐν τοῖς θεάτροις λεγούσης ἀκούομεν ἐφ᾽ οἷς ἔδρασε μεταμελομένης·</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Φίλαι γυναίκες, πῶς ἂν ἐξ ἀρχῆς δόμους</l>
              <l n="2" xml:lang="grc">Ἀθάμαντος οἰκήσαιμι, τῶν πεπραγότων</l>
              <l n="3" xml:lang="grc">δράσασα μηδέν.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="5" xml:id="fragment-ino-dindorf1893_grc1-5" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:401">
            <note type="source">5. Stobæus LXXIII, 24.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Φεῦ</l>
              <l n="2" xml:lang="grc">ὅσῳ τὸ θῆλυ δυστυχέστερον γένος</l>
              <l n="3" xml:lang="grc">πέφυκεν ἀνδρῶν· ἔν τε τοῖσι γὰρ καλοῖς</l>
              <l n="4" xml:lang="grc">πολλῷ λέλειπται κἀπὶ τοῖς αἰσχροῖς πλέον.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="6" xml:id="fragment-ino-dindorf1893_grc1-6" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:400">
            <note type="source">6. Stobæus LXXIII, 25. Arsen. Viol. p. 486 ed. Walz. sine nom. auct. et fab.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ὦ θνητὰ πράγματ', ὦ γυναικεῖαι φρένες,</l>
              <l n="2" xml:lang="grc">ὅσον νόσημὰ τὴν Κύπριν κεκτήμεθα.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="7" xml:id="fragment-ino-dindorf1893_grc1-7" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:408">
            <note type="source">7. Stobæus CX, 3.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ἐν ἐλπίσιν χρὴ τοὺς σοφοὺς ἔχειν βίον.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="8" xml:id="fragment-ino-dindorf1893_grc1-8" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:409">
            <note type="source">8. Stobæus CX, 5.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Μήτ᾿ εὐτυχοῦσα πᾶσαν ἡνίαν χάλα,</l>
              <l n="2" xml:lang="grc">κακῶς τε πράσσουσ᾽ ἐλπίδος κεδνῆς ἔχου.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="9" xml:id="fragment-ino-dindorf1893_grc1-9" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino">
            <note type="source">9. Stobæus LXXXV, 2.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Τοιάνδε χρὴ γυναικὶ πρόσπολον ἐᾶν,</l>
              <l n="2" xml:lang="grc">ἥτις τὸ μὲν δίκαιον οὐ σιγήσεται,</l>
              <l n="3" xml:lang="grc">τὰ δ᾽ αἰσχρὰ μισεῖ καὶ κατ᾽ ὀφθαλμοὺς ἔχει.</l>
              <l n="4" xml:lang="grc">σιγᾶν θ᾽ ὅπου δεῖ, καὶ λέγειν ἵν᾿ ἀσφαλὲς,</l>
              <l n="5" xml:lang="grc">ὁρᾶν θ᾽ ἃ δεῖ με, κοὐχ ὁρᾶν ἃ μὴ χρεὼν,</l>
              <l n="6" xml:lang="grc">[γαστρὸς κρατεῖν δέ. καὶ γὰρ ἐν κακοῖσιν ὧν</l>
              <l n="7" xml:lang="grc">ἐλευθέροισιν ἐμπεπαίδευμαι τρόποις.]</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="10" xml:id="fragment-ino-dindorf1893_grc1-10" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:412">
            <note type="source">10. Stobæus XIII, 7. Plut. de adul. et amic. 22 (p. 63 A.) sine nom. auct. et fab.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ἐμοὶ γὰρ εἴη πτωχὸς, εἰ δὲ βούλεται,</l>
              <l n="2" xml:lang="grc">πτωχοῦ κακίων, ὅστις ὢν εὔνους ἐμοὶ</l>
              <l n="3" xml:lang="grc">φόβον παρελθὼν τἀπὸ καρδίας ἐρεῖ.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="11" xml:id="fragment-ino-dindorf1893_grc1-11" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:407">
            <note type="source">11. Stobæus XVI, 5.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ἀμουσία τοι μήδ᾽ ἐπ᾿ οἰκτροῖσιν δάκρυ</l>
              <l n="2" xml:lang="grc">στάζειν· κακὸν δὲ, χρημάτων ὄντων ἅλις</l>
              <l n="3" xml:lang="grc">φειδοῖ πονηρᾷ μηδέν εὖ ποιεῖν βροτῶν.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="12" xml:id="fragment-ino-dindorf1893_grc1-12" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:406">
            <note type="source">12. Stobæus CXII, 3.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Μὴ σκυθρωπὸς ἴσθ᾽ ἄγαν</l>
              <l n="2" xml:lang="grc">πρὸς τοὺς κακῶς πράσσοντας ἄνθρωπος γεγώς.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="13" xml:id="fragment-ino-dindorf1893_grc1-13" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:417">
            <note type="source">13. Stobæus IX, 5. XCIV, 6.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Κέκτησο δ᾽ ὀρθῶς ἂν ἔχῃς ἄνευ ψόγου,</l>
              <l n="2" xml:lang="grc">καὶ μικρὰ σώζου τῇ δίκῃ ξυνοῦσ᾽ ἀεί</l>
              <l n="3" xml:lang="grc">μήδ᾽ ὡς κακὸς ναύκληρος εὖ πράξας ποτὲ</l>
              <l n="4" xml:lang="grc">ζητῶν τὰ πλείον εἶτα πάντ᾽ ἀπώλεσεν.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="14" xml:id="fragment-ino-dindorf1893_grc1-14" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:416">
            <note type="source">14. Stobæus IV, 9.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Πολλοί γε θνητῶν τῷ θράσει τὰς συμφορὰς</l>
              <l n="2" xml:lang="grc">ζητοῦσ᾽ ἀμαυροῦν κἀποκρύπτεσθαι κακά.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="15" xml:id="fragment-ino-dindorf1893_grc1-15" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:415">
            <note type="source">15. Stobæus CV, 19.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ἄνασσα, πολλοῖς ἐστιν ἀνθρώποις κακὰ,</l>
              <l n="2" xml:lang="grc">τοῖς δ᾽ ἄρτι λήγει, τοῖς δὲ κίνδυνος μολεῖν.</l>
              <l n="3" xml:lang="grc">κύκλος γὰρ αὑτὸς καρπίμοις τε γῆς φυτοῖς</l>
              <l n="4" xml:lang="grc">θνητῶν τε γενεᾷ· τοῖς μὲν αὔξεται βίος,</l>
              <l n="5" xml:lang="grc">τῶν δὲ φθίνει τε καὶ θερίζεται πάλιν.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="16" xml:id="fragment-ino-dindorf1893_grc1-16" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:411">
            <note type="source">16. Stobæus XLI, 1.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ἴστω δὲ μηδεὶς ταῦθ᾽, ἃ σιγᾶσθαι χρεών·</l>
              <l n="2" xml:lang="grc">μικροῦ γὰρ ἐκ λαμπτῆρος Ἰδαῖον λέπας</l>
              <l n="3" xml:lang="grc">πρήσειεν ἄν τις, καὶ πρὸς ἄνδρ᾽ εἰπὼν ἕνα</l>
              <l n="4" xml:lang="grc">πύθοιντ᾽ ἂν ἀστοὶ πάντες, ἃ κρύπτειν χρεών.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="17" xml:id="fragment-ino-dindorf1893_grc1-17" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino">
            <note type="source">17. Stobæus LXXXIX, 9.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ἐπίσταμαι δὲ πάνθ᾽, ὅσ᾽ εὐγενῆ χρεών,</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="18" xml:id="fragment-ino-dindorf1893_grc1-18" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:402">
            <note type="source">18. Stobæus LXVIII, 12.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Νόμοι γυναικῶν οὐ καλῶς κεῖνται πέρι</l>
              <l n="2" xml:lang="grc">χρῆν γὰρ τὸν εὐτυχοῦνθ᾽ ὅτι πλείστας ἔχειν</l>
              <l n="3" xml:lang="grc">γυναῖκας, εἴπερ δὴ τροφὴ δόμοις παρῆν,</l>
              <l n="4" xml:lang="grc">ὡς τὴν κακὴν μὲν ἐξέβαλλε δωμάτων,</l>
              <l n="5" xml:lang="grc">τὴν δ᾽ οὖσαν ἐσθλὴν ἡδέως ἐσώζετο</l>
              <l n="6" xml:lang="grc">νῦν δ᾽ εἰς μίαν βλέπουσι, κίνδυνον μέγαν</l>
              <l n="7" xml:lang="grc">ῥίπτοντες· οὐ γὰρ τῶν τρόπων πειρώμενοι</l>
              <l n="8" xml:lang="grc">νύμφας ἐς οἴκους ἑρματίζονται βροτοί.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="19" xml:id="fragment-ino-dindorf1893_grc1-19" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino">
            <note type="source">19. Stobæus XXXVIII, 8.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Τίς ἆρα μήτηρ ἢ πατὴρ κακὸν μέγα</l>
              <l n="2" xml:lang="grc">βροτοῖς ἔφυσε τὸν δυσώνυμον φθόνον ;</l>
              <l n="3" xml:lang="grc">ποῦ καί ποτ᾽ οἰκεῖ σώματος λαχὼν μέρος ;</l>
              <l n="4" xml:lang="grc">ἐν χερσὶν, ἢ σπλάγχνοισιν, ἢ παρ᾿ ὄμματα</l>
              <l n="5" xml:lang="grc">ἔσθ᾽ ἡμίν; ὡς ἦν μόχθος ἰατροῖς μέγας</l>
              <l n="6" xml:lang="grc">τομαῖς ἀφαιρεῖν ἢ ποτοῖς ἡ φαρμάκοις</l>
              <l n="7" xml:lang="grc">πασῶν μεγίστην τῶν ἐν ἀνθρώποις νόσων.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="20" xml:id="fragment-ino-dindorf1893_grc1-20" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:418">
            <note type="source">20. Stobæus CXXIV, 7. Arsen. Viol. p. 162 ed. Walz. c. lem. Εὐριπίδου.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Γίγνωσκε τἀνθρώπεια, μηδ' ὑπερμέτρως</l>
              <l n="2" xml:lang="grc">ἄλγει˙ κακοῖς γὰρ οὐ σὺ πρόσκεισαι μόνη.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="21" xml:id="fragment-ino-dindorf1893_grc1-21" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:419">
            <note type="source">21. Stobæus X, 23. c. 1. Ἰνοῦς. XCIII, 4. c. 1. Ἴωνι pro Ἰνοῖ.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Βίᾳ νυν ἕλκετ᾽, ὦ κακοὶ, τιμὰς, βροτοί,</l>
              <l n="2" xml:lang="grc">καὶ κτᾶσθε πλοῦτον, πάντοθεν θηρώμενοι</l>
              <l n="3" xml:lang="grc">σύμμικτα, μὴ δίκαια καὶ δίκαι᾽ ὁμοῦ·</l>
              <l n="4" xml:lang="grc">ἔπειτ᾿ ἀμᾶσθε τῶνδε δύστηνον θέρος.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="22" xml:id="fragment-ino-dindorf1893_grc1-22" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:421">
            <note type="source">22. Polluc. Onom. VII, 178. Εὐρ. ἐν Ἰνοῖ.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Κοίλοις ἐν ἄντροις ἄλυχνος, ὥστε θὴρ μόνος.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="23" xml:id="fragment-ino-dindorf1893_grc1-23" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:420">
            <note type="source">23. Stobæus CV, 1.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ὁρᾷς τυράννους διὰ μακρῶν ηὐξημένους</l>
              <l n="2" xml:lang="grc">ὡς μικρὰ τὰ σφάλλοντα, καὶ μί᾽ ἡμέρα</l>
              <l n="3" xml:lang="grc">τὸν μὲν καθεῖλεν ὑψόθεν, τὸν δ᾽ ἦρ᾽ ἄνω.</l>
              <l n="4" xml:lang="grc">ὑπόπτερος δ᾽ ὁ πλοῦτος· οἷς γὰρ ἦν ποτε,</l>
              <l n="5" xml:lang="grc">ἐξ ἐλπίδων πίπτοντας ὑπτίους ὁρῶ.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="24" xml:id="fragment-ino-dindorf1893_grc1-24" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino" sameAs="urn:cts:greekLit:tlg0006.ino.nauck1889grc1:414">
            <note type="source">24. Stobæus LXXXVI, 8.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Φειδώμεθ᾽ ἀνδρῶν εὐγενῶν, φειδώμεθα,</l>
              <l n="2" xml:lang="grc">κακοὺς δ᾽ ἀποπτύωμεν, ὥσπερ ἄξιοι.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="25" xml:id="fragment-ino-dindorf1893_grc1-25" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_ino">
            <note type="source">25. Schol. Aristoph. Plut. 521. καὶ Εὐρ. ἐν Ἰνοῖ (sic cod. Ven.).</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">πολλοὶ παρῆσαν, ἀλλ᾽ ἄπιστοι Θεσσαλοί.</l>
            </lg>
            <note type="commentary">De exitu fabulæ spectatores haud dubie deorum aliquis certiores facit, cujus ex narratione petiti videntur versus, quos servavit Athenag. Leg. pro Christ. c. 26 (p. 307 ed. Hag. Com. 1742) sic scribens : Ἰνὼ μετὰ τὴν μανίαν — θεὸν δοξάζουσι γεγονέναι</note>
            <quote>
              <lg type="fragment">
                <l n="2" xml:lang="grc">Πόντου πλάνητες Λευκοθέαν ἐπώνυμον,</l>
                <l n="3" xml:lang="grc">καὶ τὸν παῖδα αὐτῆς</l>
                <l n="4" xml:lang="grc">Σεμνὸς Παλαίμων ναυτίλοις κεκλήσεται.</l>
              </lg>
            </quote>
