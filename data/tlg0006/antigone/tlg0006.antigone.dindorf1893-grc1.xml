  <text xml:lang="grc"><body xml:base="urn:cts:greekLit:tlg0006.antigone.dindorf1893-grc1"><div type="edition" n="urn:cts:greekLit:tlg0006.antigone.dindorf1893-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_antigone"><head>ΑΝΤΙΓΟΝΗ</head><div type="textpart" subtype="fragment" n="1" xml:id="fragment-antigone-dindorf1893_grc1-1" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_antigone">
            <note type="source">1. Aristoph. Ran. 1213.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ἦν Οἰδίπους τὸ πρῶτον εὐδαίμων ἀνὴρ,</l>
              <l n="2" xml:lang="grc">εἶτ᾽ ἐγένετ᾽ αὖθις ἀθλιώτατος βροτῶν.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="2" xml:id="fragment-antigone-dindorf1893_grc1-2" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_antigone">
            <note type="source">2. Stobæus CXXV, 6.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Θάνατος γὰρ ἀνθρώποισι νεικέων τέλος</l>
              <l n="2" xml:lang="grc">ἔχει· τί γὰρ τοῦδ᾽ ἐστὶ μεῖζον ἐν βροτοῖς;</l>
              <l n="3" xml:lang="grc">τίς γὰρ πετραῖον σκόπελον οὐτάζων δορὶ</l>
              <l n="4" xml:lang="grc">ὀδύναισι δώσει; τίς δ᾽ ἀτιμάζων νέκυς,</l>
              <l n="5" xml:lang="grc">εἰ μηδὲν αἰσθάνοιντο τῶν παθημάτων;</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="3" xml:id="fragment-antigone-dindorf1893_grc1-3" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_antigone">
            <note type="source">3. Stobæus LXIII, 4.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ἀνδρὸς δ᾽ ὁρῶντος εἰς Κύπριν νεανίου</l>
              <l n="2" xml:lang="grc">ἀφύλακτος ἡ τήρησις· ἦν γὰρ φαῦλος ᾖ</l>
              <l n="3" xml:lang="grc">τἄλλ᾽, εἰς ἐρῶτα πᾶς ἀνὴρ σοφώτερος.</l>
              <l n="4" xml:lang="grc">ἦν δ᾽ αὖ προσῆται Κύπρις, ἥδιστον λαβεῖν.</l>
              <l n="5" xml:lang="grc">ἀλλ᾽ ἕν γ᾽ ἔχει τι χρηστόν· ἐν κήδει γὰρ ἂν</l>
              <l n="6" xml:lang="grc">ἐσθλῷ δέδοικε μηδὲν ἐξαμαρτάνειν.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="4" xml:id="fragment-antigone-dindorf1893_grc1-4" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_antigone">
            <note type="source">4. Stobæi Append. Florent. ed. Gaisf. vol. IV, p. 20.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Νέοι νέοισι συννοσοῦσι τἀφανῆ.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="5" xml:id="fragment-antigone-dindorf1893_grc1-5" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_antigone">
            <note type="source">5. Stobæus LXVII, 13.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ζευχθεὶς γάμοισιν οὐκέτ᾽ ἔστ᾽ ἐλεύθερος,</l>
            </lg>
          </div>
        <div type="textpart" subtype="fragment" n="6" xml:id="fragment-antigone-dindorf1893_grc1-6" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_antigone">
            <note type="source">6. Clem. Alex. Strom. VI, 2. § 10. p. 741 P. Stobæus LXXVII, 10.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ὀνόματι μεμπτὸν τὸ νόθον, ἡ φύσις δ᾽ ἴση.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="7" xml:id="fragment-antigone-dindorf1893_grc1-7" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_antigone">
            <note type="source">7. Stobæus XCIII, 13.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ἀνδρὸς φίλου δὲ χρυσὸς ἀμαθίας μέτα</l>
              <l n="2" xml:lang="grc">ἄχρηστος, εἰ μὴ κἀρετὴν ἔχων τύχοι.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="8" xml:id="fragment-antigone-dindorf1893_grc1-8" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_antigone">
            <note type="source">8. Stobæus XC, 1.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Τὸ μῶρον αὐτῷ τοῦ πατρὸς νόσημ᾽ ἔνι·</l>
              <l n="2" xml:lang="grc">φιλεῖ γὰρ οὕτως ἐκ κακῶν εἶναι κακούς.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="9" xml:id="fragment-antigone-dindorf1893_grc1-9" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_antigone">
            <note type="source">9. Stobæus LXXXVII, 1.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ἡ γὰρ δόκησις πατράσι παῖδας εἰκέναι</l>
              <l n="2" xml:lang="grc">τὰ πολλὰ ταύτῃ γίγνεται τέκνων πέρι.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="10" xml:id="fragment-antigone-dindorf1893_grc1-10" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_antigone">
            <note type="source">10. Stobæi Append. Florent. ed. Gaisf. vol. IV, p. 28.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ἄκουσον· οὐ γὰρ οἱ κακῶς πεπραγότες</l>
              <l n="2" xml:lang="grc">σὺν ταῖς τύχαισι τοὺς λόγους ἀπώλεσαν.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="11" xml:id="fragment-antigone-dindorf1893_grc1-11" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_antigone">
            <note type="source">11. Orion. Anthologn. I, 1, p. 41. ed. Schneidewin. Tzetz. ad Hesiod. Op. 135.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Οὐκ ἔστι Πειθοῦς ἱρὸν ἄλλο πλὴν λόγος,</l>
              <l n="2" xml:lang="grc">καὶ βωμὸς αὐτῆς ἐστ᾽ ἐν ἀνθρώπων φύσει.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="12" xml:id="fragment-antigone-dindorf1893_grc1-12" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_antigone">
            <note type="source">12. Stobæus LXIV, 4. Plutarch. ap. Stobæum p. 503 ed. Wyttenb. T. V, p. 854.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ἥρων· τὸ μαίνεσθαι δ᾽ ἄρ᾽ ἦν ἔρως βροτοῖς.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="13" xml:id="fragment-antigone-dindorf1893_grc1-13" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_antigone">
            <note type="source">13. Stobæus XLIX, 5.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Οὔτ᾽ εἰκὸς ἄρχειν, οὔτ᾽ ἐχρῆν εἶναι νόμον</l>
              <l n="2" xml:lang="grc">τύραννον εἶναι μωρία δὲ καὶ θέλειν,</l>
              <l n="3" xml:lang="grc">ὃς τῶν ὁμοίων βούλεται κρατεῖν μόνος.</l>
            </lg>
            <note type="commentary">Pflugkius (in Zimmerm. Diar. schol. 1831, p. 19), priorem fragmenti partem vitiosam, initio nonnulla verba excidisse, totumque locum ita adornandum esse judicat:</note>
            <lg type="fragment">
              <l n="4" xml:lang="grc">[τῶν δ᾽ ἐλευθέρων]</l>
              <l n="5" xml:lang="grc">οὔτ᾽ εἰκὸς ἄρχειν, οὔτ᾽ ἐχρῆν, εἴπερ νόμον,</l>
              <l n="6" xml:lang="grc">τύραννον εἶναι· μωρία δὲ καὶ θέλειν,</l>
              <l n="7" xml:lang="grc">ὃς τῶν ὁμοίων βούλεται κρατεῖν μόνος·</l>
            </lg>
            <note type="commentary">“h. e. nec ingenuis imperare neque, si quidem legem, dominatorem esse oportere; insaniam vero etiam esse, quicunque solus de paribus imperium tenere velit.”</note>
          </div>
          <div type="textpart" subtype="fragment" n="14" xml:id="fragment-antigone-dindorf1893_grc1-14" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_antigone">
            <note type="source">14. Stobæus XLVIII, 4.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Δεῖ τοῖσι πολλοῖς τὸν τύραννον ἁνδάνειν.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="15" xml:id="fragment-antigone-dindorf1893_grc1-15" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_antigone">
            <note type="source">15. Stobæus XLIII, 21.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Οἰκεῖος ἀνθρώποισι γίγνεσθαι φιλεῖ</l>
              <l n="2" xml:lang="grc">πόλεμος ἐν ἄστει, ἦν διχοστατῇ πόλις.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="16" xml:id="fragment-antigone-dindorf1893_grc1-16" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_antigone">
            <note type="source">16. Stobæus CIV, 9.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">ἐπ᾽ ἄκραν ἥκομεν γραμμὴν κακῶν.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="17" xml:id="fragment-antigone-dindorf1893_grc1-17" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_antigone">
            <note type="source">17. Stobæus CVIII, 3.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Μὴ οὖν θέλε λυπεῖν σαυτὸν εἰδὼς, πολλάκις</l>
              <l n="2" xml:lang="grc">ὅτι τὸ λυποῦν ὕστερον χαρὰν ἄγει,</l>
              <l n="3" xml:lang="grc">καὶ τὸ κακὸν ἀγαθοῦ γίγνεται παραίτιον.</l>
            </lg>
            <note type="commentary">Sed recte monuit Valck. Diatr. p. 156 μὴ οὐ quidem semper in unam syllabam coalescere, nusquam vero μὴ οὖν. Ipse igitur in hunc modum restituit locum:</note>
            <lg type="fragment">
              <l n="4" xml:lang="grc">μή νυν θέλε</l>
              <l n="5" xml:lang="grc">λυπεῖν σεαυτὸν, [Αἷμον], εἰδὼς πολλάκις</l>
              <l n="6" xml:lang="grc">ὅτι καὶ τὸ λυποῦν ὕστερον χαρὰν ἄγει.</l>
            </lg>
          </div>
          </div></body></text></TEI>
