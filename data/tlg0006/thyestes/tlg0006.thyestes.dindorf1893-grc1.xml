  <text xml:lang="grc"><body xml:base="urn:cts:greekLit:tlg0006.thyestes.dindorf1893-grc1"><div type="edition" n="urn:cts:greekLit:tlg0006.thyestes.dindorf1893-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_thyestes"><head>ΘΥΕΣΤΗΣ</head><div type="textpart" subtype="fragment" n="1" xml:id="fragment-thyestes-dindorf1893_grc1-1" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_thyestes" sameAs="urn:cts:greekLit:tlg0006.thyestes.nauck1889grc1:395">
            <note type="source">1. Stobæus XCII, 3.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Πλούτου δ᾽ ἀπορρυέντος ἀσθενεῖς γάμοι·</l>
              <l n="2" xml:lang="grc">τὴν μὲν γὰρ εὐγένειαν αἰνοῦσιν βροτοί,</l>
              <l n="3" xml:lang="grc">μᾶλλον δὲ κηδεύουσι τοῖς εὐδαίμοσιν.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="2" xml:id="fragment-thyestes-dindorf1893_grc1-2" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_thyestes" sameAs="urn:cts:greekLit:tlg0006.thyestes.nauck1889grc1:392">
            <note type="source">2. Stobæus XCVIII, 21.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">εἰ δ᾽ ἄτερ πόνων</l>
              <l n="2" xml:lang="grc">δοκεῖς ἔσεσθαι, μῶρος εἶ, θνητὸς γεγώς.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="3" xml:id="fragment-thyestes-dindorf1893_grc1-3" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_thyestes" sameAs="urn:cts:greekLit:tlg0006.thyestes.nauck1889grc1:394">
            <note type="source">3. Gaisf. Append. Florent. ad Stobæum 11, 19.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">οὐ πώποτ᾽ ἔργου μᾶλλον εἰλόμην λόγους.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="4" xml:id="fragment-thyestes-dindorf1893_grc1-4" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_thyestes" sameAs="urn:cts:greekLit:tlg0006.thyestes.nauck1889grc1:393">
            <note type="source">4. Orion. Anthologn. VII, 4, p. 51 et post tit. VIII, farrag. Euripid. 19, p. 57 ed. Schneidew.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Γνωμης γαρ οὐδὲν ἁρετὴ μονουμένη</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="5" xml:id="fragment-thyestes-dindorf1893_grc1-5" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_thyestes" sameAs="urn:cts:greekLit:tlg0006.thyestes.nauck1889grc1:397">
            <note type="source">5. Orion. Anthologn. V, 6, p. 47 ed. Schneidew.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Θεοῦ θέλο· τος κἂν ἐπὶ ῥιπὸς πλέοις.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="6" xml:id="fragment-thyestes-dindorf1893_grc1-6" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_thyestes" sameAs="urn:cts:greekLit:tlg0006.thyestes.nauck1889grc1:391">
            <note type="source">6. Orion. Anthologn. V, 7, p. 47 ed. Schneidew.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Οὐκ ἔστιν οὐδὲν χωρὶς ἀνθρώποις θεῶν.</l>
              <l n="2" xml:lang="grc">σπουδάζομεν δὲ πόλλ᾽ ὑπ᾽ ἑλπίδων μάτην</l>
              <l n="3" xml:lang="grc">πόνους ἔχοντες οὐδὲν εἰδότες σαφές.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="7" xml:id="fragment-thyestes-dindorf1893_grc1-7" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0006_thyestes" sameAs="urn:cts:greekLit:tlg0006.thyestes.nauck1889grc1:396">
            <note type="source">7. Aristot. Rhet. II, 23.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ἀλλ' εἴπερ ἐστὶν ἐν βροτοῖς ψευδηγορεῖν</l>
              <l n="2" xml:lang="grc">πιθανὸν, νομίζειν χρή γε καὶ τούναντίον,</l>
              <l n="3" xml:lang="grc">ἄπιστ᾽ ἀληθῆ πολλὰ συμβαίνειν βροτοῖς.</l>
            </lg>
          </div>
        </div></body></text></TEI>
