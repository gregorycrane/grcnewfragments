  <text xml:lang="grc"><body xml:base="urn:cts:greekLit:tlg0011.danae.dindorf1893-grc1"><div type="edition" n="urn:cts:greekLit:tlg0011.danae.dindorf1893-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_danae"><head>ΔΑΝΑΗ</head><div type="textpart" subtype="fragment" n="176" xml:id="fragment-danae-dindorf1893_grc1-176" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_danae" sameAs="urn:cts:greekLit:tlg0011.danae.nauck1889grc1:168">
            <note type="source">Scholiasta Ajacis v. 1. et Suidas in πεῖρα,</note>
            <quote>Πεῖρα γὰρ ἡ βλάβη, ὡς καὶ ἐν Δανάῃ</quote>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Οὐκ οἶδα τὴν σὴν πεῖραν· ἓν δ᾽ ἐπίσταμαι,</l>
              <l n="2" xml:lang="grc">τοῦ παιδὸς ὄντος τοῦδ᾽ ἐγὼ διόλλυμαι.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="177" xml:id="fragment-danae-dindorf1893_grc1-177" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_danae" sameAs="urn:cts:greekLit:tlg0011.danae.nauck1889grc1:171">
            <note type="source">Hesychius,</note>
            <quote>Ἀνθήμερον: σήμερον ἡμέρα.</quote>
            <note type="commentary">Σ. Δανάῃ. Brunckius Αὐθημερόν. Præcedit apud Hesychium, Ἀνθ᾽ ἡμέρας: δι᾽ ὅλης τῆς ἡμέρας.</note>
          </div>
          <div type="textpart" subtype="fragment" n="178" xml:id="fragment-danae-dindorf1893_grc1-178" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_danae" sameAs="urn:cts:greekLit:tlg0011.danae.pearson1917-grc1:166">
            <note type="source">Hesychius,</note>
            <quote>Ἀφροδισία ἄγρα: Σ. Δανάῃ</quote>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Γόνον τε μήλων κἀφροδισίαν ἄγραν.</l>
            </lg>
            <note type="commentary">Codex γόνοιον μήλων.</note>
          </div>
          <div type="textpart" subtype="fragment" n="179" xml:id="fragment-danae-dindorf1893_grc1-179" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_danae" sameAs="urn:cts:greekLit:tlg0011.danae.nauck1889grc1:172">
            <note type="source">Antiatticista p. 85, 18.</note>
            <quote>Βράχιστον: βραχύτατον. Σ. Δανάῃ.</quote>
          </div>
          <div type="textpart" subtype="fragment" n="180" xml:id="fragment-danae-dindorf1893_grc1-180" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_danae" sameAs="urn:cts:greekLit:tlg0011.danae.nauck1889grc1:173">
            <note type="source">Antiatticista p. 90, 31.</note>
            <quote>Δαιμονίζεσθαι: Σ. Δανάῃ. δεδαιμονισμένον ἀντὶ τοῦ τεθεωμένον.</quote>
          </div>
          <div type="textpart" subtype="fragment" n="181" xml:id="fragment-danae-dindorf1893_grc1-181" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_danae" sameAs="urn:cts:greekLit:tlg0011.danae.nauck1889grc1:170">
            <note type="source">Antiatticista p. 97, 31.</note>
            <quote>Ζῆ: ἀντὶ τοῦ ζῆθι. — Σ. Δανάῃ</quote>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ζῆ, πῖνε, φέρβου.</l>
            </lg>
          </div>
        </div></body></text></TEI>
