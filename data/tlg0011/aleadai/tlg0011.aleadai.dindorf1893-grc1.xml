  <text xml:lang="grc"><body xml:base="urn:cts:greekLit:tlg0011.aleadai.dindorf1893-grc1"><div type="edition" n="urn:cts:greekLit:tlg0011.aleadai.dindorf1893-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_aleadai"><head>ΑΛΕΑΔΑΙ</head><div type="textpart" subtype="fragment" n="98" xml:id="fragment-aleadai-dindorf1893_grc1-98" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_aleadai" sameAs="urn:cts:greekLit:tlg0011.aleadai.nauck1889grc1:74">
            <note type="source">Apud grammaticos interdum Ἀλωάδαι scriptum: quod male probat Valcken. Diatr. p. 15. Stobæus IV, 37.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ἐνταῦθα μέντοι πάντα τἀνθρώπων νοσεῖ,</l>
              <l n="2" xml:lang="grc">κακοῖς ὅταν θέλωσιν ἰᾶσθαι κακά.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="99" xml:id="fragment-aleadai-dindorf1893_grc1-99" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_aleadai" sameAs="urn:cts:greekLit:tlg0011.aleadai.nauck1889grc1:75">
            <note type="source">Stobæus IX, 4.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Τοῖς γὰρ δικαίοις ἀντέχειν οὐ ῥάδιον.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="100" xml:id="fragment-aleadai-dindorf1893_grc1-100" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_aleadai" sameAs="urn:cts:greekLit:tlg0011.aleadai.nauck1889grc1:76">
            <note type="source">Stobæus XII, 3.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Κακὸν τὸ κεύθειν κοὐ πρὸς ἀνδρὸς εὐγενοῦς.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="101" xml:id="fragment-aleadai-dindorf1893_grc1-101" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_aleadai" sameAs="urn:cts:greekLit:tlg0011.aleadai.nauck1889grc1:77">
            <note type="source">Stobæus XIII, 6.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Καὶ γὰρ δικαία γλῶσσ' ἔχει κράτος μέγα.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="102" xml:id="fragment-aleadai-dindorf1893_grc1-102" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_aleadai" sameAs="urn:cts:greekLit:tlg0011.aleadai.nauck1889grc1:78">
            <note type="source">Stobæus XXXIII, 3.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ὦ παῖ, σιώπα· πόλλ' ἔχει σιγὴ καλά.</l>
            </lg>
            <note type="commentary">Sine auctoris nomine attulit Plutarchus Moral. p. 502 e. Menandro tribuit Apostolius XXI, 16. Menandri est qui apud Stobæum præcedit versus.</note>
          </div>
          <div type="textpart" subtype="fragment" n="103" xml:id="fragment-aleadai-dindorf1893_grc1-103" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_aleadai" sameAs="urn:cts:greekLit:tlg0011.aleadai.nauck1889grc1:79">
            <note type="source">Stobæus XXXVI, 11.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Τί ταῦτα πολλῶν ῥημάτων ἔτ' ἐστί σοι;</l>
              <l n="2" xml:lang="grc">τὰ γὰρ περισσὰ πανταχοῦ λυπήρ' ἔπη.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="104" xml:id="fragment-aleadai-dindorf1893_grc1-104" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_aleadai" sameAs="urn:cts:greekLit:tlg0011.aleadai.nauck1889grc1:80">
            <note type="source">Stobæus XLI, 4.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Μὴ πάντ' ἐρεύνα· πολλὰ καὶ λαθεῖν καλόν.</l>
            </lg>
            <note type="commentary">Ita Blomfildus. Vulgo λαλεῖν καλόν.</note>
          </div>
          <div type="textpart" subtype="fragment" n="105" xml:id="fragment-aleadai-dindorf1893_grc1-105" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_aleadai" sameAs="urn:cts:greekLit:tlg0011.aleadai.nauck1889grc1:81">
            <note type="source">Stobæus XLIII, 6.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Κοὐκ οἶδ' ὅ τι χρὴ πρὸς ταῦτα λέγειν,</l>
              <l n="2" xml:lang="grc">ὅταν οἱ τ' ἀγαθοὶ πρὸς τῶν ἀγενῶν</l>
              <l n="3" xml:lang="grc">κατανικῶνται,</l>
              <l n="4" xml:lang="grc">ποία πόλις ἂν τάδ' ἐνέγκοι;</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="106" xml:id="fragment-aleadai-dindorf1893_grc1-106" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_aleadai" sameAs="urn:cts:greekLit:tlg0011.aleadai.nauck1889grc1:82">
            <note type="source">Stobæus LIV, 21.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Δοκῶ μὲν, οὐδείς· ἀλλ' ὅρα μὴ κρείσσον</l>
              <l n="2" xml:lang="grc">καὶ δυσσεβοῦντα τῶν ἐναντίων κρατεῖν</l>
              <l n="3" xml:lang="grc">ἢ δοῦλον αὐτὸν ὄντα τῶν πέλας κλύειν.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="107" xml:id="fragment-aleadai-dindorf1893_grc1-107" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_aleadai" sameAs="urn:cts:greekLit:tlg0011.aleadai.nauck1889grc1:83">
            <note type="source">Stobæus LXXVI, 9.</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Παῦσαι. καταρκεῖ τοῦδε κεκλῆσθαι πατρὺς,</l>
              <l n="2" xml:lang="grc">εἴπερ πέφυκά γ'· εἰ δὲ μή, μείων βλάβη.</l>
              <l n="3" xml:lang="grc">τό τοι νομισθὲν τῆς ἀληθείας κρατεῖ.</l>
            </lg>
          </div>
        </div></body></text></TEI>
