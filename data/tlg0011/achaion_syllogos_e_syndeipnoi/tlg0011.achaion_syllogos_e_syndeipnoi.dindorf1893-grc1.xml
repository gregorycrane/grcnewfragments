  <text xml:lang="grc"><body xml:base="urn:cts:greekLit:tlg0011.achaion_syllogos_e_syndeipnoi.dindorf1893-grc1"><div type="edition" n="urn:cts:greekLit:tlg0011.achaion_syllogos_e_syndeipnoi.dindorf1893-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_achaion_syllogos_e_syndeipnoi"><head>ΑΧΑΙΩΝ ΣΥΛΛΟΓΟΣ Η ΣΥΝΔΕΙΠΝΟΝ Η ΣΥΝΔΕΙΠΝΟΙ</head><div type="textpart" subtype="fragment" n="146" xml:id="fragment-achaion_syllogos_e_syndeipnoi-dindorf1893_grc1-146" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_achaion_syllogos_e_syndeipnoi" sameAs="urn:cts:greekLit:tlg0011.achaion_syllogos_e_syndeipnoi.nauck1889grc1:145">
            <note type="source">Stobæus XXVI, 1. Σ. ἐκ Συνδείπνου</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Λάθα Πιερίσι στυγερὰ καὶ ἀνάρετος</l>
              <l n="2" xml:lang="grc">ὠδυνάσεις θανάτοις εὐποτμότατε,</l>
              <l n="3" xml:lang="grc">μελέων ἀνέχουσα βίου βραχὺν ἰσθμόν.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="147" xml:id="fragment-achaion_syllogos_e_syndeipnoi-dindorf1893_grc1-147" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_achaion_syllogos_e_syndeipnoi" sameAs="urn:cts:greekLit:tlg0011.achaion_syllogos_e_syndeipnoi.nauck1889grc1:140">
            <note type="source">Athenæus I. p. 17 d. (ex eo Eustathius p. 1828, 28.) Σ. ἐν Ἀχαιῶν συνδείπνῳ</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Ἀλλ᾽ ἀμφὶ θυμῷ τὴν κάκοσμον οὐράνην</l>
              <l n="2" xml:lang="grc">ἔρριψεν οὐδ᾽ ἥμαρτε· περὶ δ᾽ ἐμῷ κάρᾳ</l>
              <l n="3" xml:lang="grc">κατάγνυται τὸ τεῦχος οὐ μύρου πνέον·</l>
              <l n="4" xml:lang="grc">ἐδειματούμην δ᾽ οὐ φίλης ὀσμῆς ὕπο.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="148" xml:id="fragment-achaion_syllogos_e_syndeipnoi-dindorf1893_grc1-148" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_achaion_syllogos_e_syndeipnoi" sameAs="urn:cts:greekLit:tlg0011.achaion_syllogos_e_syndeipnoi.nauck1889grc1:139">
            <note type="source">Athenæus XV. p. 679 a. Σ. Συνδείπνοις</note>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Οὔτοι γένειον ὧδε χρὴ διηλιφές</l>
              <l n="2" xml:lang="grc">φοροῦντα κἀντίπαιδα καὶ γένει μέγαν</l>
              <l n="3" xml:lang="grc">γαστρὸς καλεῖσθαι παῖδα, τοῦ πατρὸς παρόν.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="149" xml:id="fragment-achaion_syllogos_e_syndeipnoi-dindorf1893_grc1-149" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_achaion_syllogos_e_syndeipnoi" sameAs="urn:cts:greekLit:tlg0011.achaion_syllogos_e_syndeipnoi.nauck1889grc1:138">
            <note type="source">Athenæus XV. p. 686 a.</note>
            <quote>Τοῖς παισὶ παρακελεύομαι κατὰ τὸν Σοφοκλέα, ὃς ἐν Συνδείπνοις φησὶ</quote>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Φορεῖτε, μασσέτω τις, ἐγχείτω βαθὺν</l>
              <l n="2" xml:lang="grc">κρητῆρ᾽᾽ ὅδ᾽ ἁνὴρ οὐ πρὶν ἂν φάγῃ καλῶς</l>
              <l n="3" xml:lang="grc">ὅμοια καὶ βοῦς ἐργάτης ἐργάζεται.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="150" xml:id="fragment-achaion_syllogos_e_syndeipnoi-dindorf1893_grc1-150" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_achaion_syllogos_e_syndeipnoi" sameAs="urn:cts:greekLit:tlg0011.achaion_syllogos_e_syndeipnoi.nauck1889grc1:144">
            <note type="source">Schol. Pindari Isthm. II, 68.</note>
            <quote>Τὸ γὰρ ἀπόνειμον ἀντὶ τοῦ ἀνάγνωθι. Σοφοκλῆς ἐν Ἀχαιῶν συλλόγῳ</quote>
            <lg type="fragment">
              <l n="1" xml:lang="grc">Σὺ δ᾽ ἐν θρόνοισι γραμμάτων πτύχας ἔχων</l>
              <l n="2" xml:lang="grc">νέμ᾽ εἴ τις οὐ πάρεστιν ὃς ξυνώμοσε.</l>
            </lg>
            <note type="apparatus">V. 2. Libri ἀπόνειμον νέμει τις οὐ πάρεστι τις ξυνώμοσε. Correxit Bergkius.</note>
          </div>
        </div></body></text></TEI>
