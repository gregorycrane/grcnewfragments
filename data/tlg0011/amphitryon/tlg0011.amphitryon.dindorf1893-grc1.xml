          </div>
          <div type="textpart" subtype="fragment" n="126" xml:id="fragment-amphitryon-dindorf1893_grc1-126" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0011_amphitryon" sameAs="urn:cts:greekLit:tlg0011.amphitryon.nauck1889grc1:120">
