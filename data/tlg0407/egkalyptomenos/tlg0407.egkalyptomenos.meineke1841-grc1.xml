    <body n="urn:cts:greekLit:tlg0407.egkalyptomenos.meineke1841-grc1" xml:lang="grc">
      <div type="edition" n="urn:cts:greekLit:tlg0407.egkalyptomenos.meineke1841-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0407_egkalyptomenos">
        <head>ΕΓΚΑΛΥΠΤΟΜΕΝΟΣ</head>
        <div type="textpart" subtype="fragment" n="unnumbered" ana="#compiled-unnumbered-fragment" xml:id="meineke-0407-egkalyptomenos-unnumbered">
          <lg>
            <l n="1" xml:id="meineke-0407-egkalyptomenos-unnumbered-l1">Σόφων Ἀκαρνὰν καὶ Ῥόδιος Δαμόξενος</l>
            <l n="2" xml:id="meineke-0407-egkalyptomenos-unnumbered-l2">ἐγένονθ᾽ ἑαυτῶν συμμαθηταὶ τῆς τέχνης·</l>
            <l n="3" xml:id="meineke-0407-egkalyptomenos-unnumbered-l3">ἐδίδασκε δ᾽ αὐτοὺς Σικελιώτης Λάβδακος.</l>
            <l n="4" xml:id="meineke-0407-egkalyptomenos-unnumbered-l4">οὗτοι τὰ μὲν παλαιὰ καὶ θρυλούμενα</l>
            <l n="5" xml:id="meineke-0407-egkalyptomenos-unnumbered-l5">ἀρτίματ᾽ ἐξήλειψαν ἐκ τῶν βιβλίων,</l>
            <l n="6" xml:id="meineke-0407-egkalyptomenos-unnumbered-l6">καὶ τὴν θυείαν ἠφάνισαν ἐκ τοῦ μέσου,</l>
            <l n="7" xml:id="meineke-0407-egkalyptomenos-unnumbered-l7">οἷον λέγω κύμινον, ὄξος, σίλφιον,</l>
            <l n="8" xml:id="meineke-0407-egkalyptomenos-unnumbered-l8">τυρόν, κορίαννον, οἷς ὁ Κρόνος ἀρτύμασιν</l>
            <l n="9" xml:id="meineke-0407-egkalyptomenos-unnumbered-l9">ἐχρᾶτο, πάντ᾽ ἀφεῖλον εἶναί θ᾽ ὑπέλαβον</l>
            <l n="10" xml:id="meineke-0407-egkalyptomenos-unnumbered-l10">τὸν τοῖς τοιούτοις παντοπώλην χρώμενον.</l>
            <l n="11" xml:id="meineke-0407-egkalyptomenos-unnumbered-l11">αὐτοὶ δ᾽ ἔλαιον καὶ λοπάδα καινήν, πάτερ,</l>
            <l n="12" xml:id="meineke-0407-egkalyptomenos-unnumbered-l12">πῦρ τ᾽ ὀξὺ καὶ μὴ πολλάκις φυσώμενον</l>
            <l n="13" xml:id="meineke-0407-egkalyptomenos-unnumbered-l13">ἐποίουν· ἀπὸ τούτου πᾶν τὸ δεῖπνον εὐτρεπές.</l>
            <l n="14" xml:id="meineke-0407-egkalyptomenos-unnumbered-l14">οὗτοί τε πρῶτον δάκρυα καὶ πταρμὸν πολὺν</l>
            <l n="15" xml:id="meineke-0407-egkalyptomenos-unnumbered-l15">ἀπὸ τῆς τραπέζης καὶ σίαλον ἀπήγαγον,</l>
            <l n="16" xml:id="meineke-0407-egkalyptomenos-unnumbered-l16">τῶν τ᾽ ἐσθιόντων ἀνεκάθηραν τοὺς πόρους.</l>
            <l n="17" xml:id="meineke-0407-egkalyptomenos-unnumbered-l17">ὁ μὲν οὖν Ῥόδιος πιών τιν᾽ ἅλμην ἀπέθανεν.</l>
            <l n="18" xml:id="meineke-0407-egkalyptomenos-unnumbered-l18">παρὰ τὴν φύσιν γὰρ τὸ ποτὸν ἦν. μάλ᾽ εἰκότως.</l>
            <l n="19" xml:id="meineke-0407-egkalyptomenos-unnumbered-l19">ὁ Σόφων δὲ πᾶσαν τὴν Ἰωνίαν ἔχει,</l>
          </lg>
        </div>
