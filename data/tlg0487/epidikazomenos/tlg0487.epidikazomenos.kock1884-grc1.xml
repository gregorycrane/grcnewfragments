  <text xml:base="urn:cts:greekLit:tlg0487.epidikazomenos.kock1884-grc1" xml:lang="grc"><body n="urn:cts:greekLit:tlg0487.epidikazomenos.kock1884-grc1" xml:lang="grc"><div type="edition" n="urn:cts:greekLit:tlg0487.epidikazomenos.kock1884-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0487_epidikazomenos"><head>ΕΠΙΔΙΚΑΖΟΜΕΝΟΣ</head><div type="textpart" subtype="fragment" n="23" xml:id="kock-0487-epidikazomenos-23" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0487_epidikazomenos">
              <lg>
                <l n="1" xml:id="kock-0487-epidikazomenos-23-l1" xml:lang="grc">ἥδιον οὐδὲν οὐδὲ μουσικώτερον</l>
                <l n="2" xml:id="kock-0487-epidikazomenos-23-l2" xml:lang="grc">ἔστ’ ἢ δύνασθαι λοιδορούμενον φέρειν·</l>
                <l n="3" xml:id="kock-0487-epidikazomenos-23-l3" xml:lang="grc">ὁ λοιδορῶν γάρ, ἂν ὁ λοιδορούμενος</l>
                <l n="4" xml:id="kock-0487-epidikazomenos-23-l4" xml:lang="grc">μὴ προσποιῆται, λοιδορεῖται λοιδορῶν.</l>
              </lg>
              <note type="source">Stobaeus Floril. 19, 2 <foreign xml:lang="grc">Φιλήμονος ἐκ τοῦ δικαζομένου</foreign> A. <foreign xml:lang="grc">ἐκ δικαζομένου</foreign> Voss. rectius titulus adfertur ibid. 13, 11 (fr. 24).</note>
              <note type="apparatus">v. 1. 2 Plutarchus Mor. 35 d <foreign xml:lang="grc">φέρειν δὲ πρᾴως καὶ σκώμματα καὶ λοιδορίας καὶ γέλωτας, μάλιστα μὲν τὸ τοῦ Φιλήμονος ἔχοντας πρόχειρον κτλ.</foreign> v. 3 Anton. Mel. 53 p. 79. 4. <foreign xml:lang="grc">ὁ λοιδορῶν</foreign> m. pr. A Stob. <foreign xml:lang="grc">ἂν μὴ προσποιῆται</foreign>, cum se laedi dissimulat.</note>
            </div>
            <div type="textpart" subtype="fragment" n="24" xml:id="kock-0487-epidikazomenos-24" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0487_epidikazomenos">
              <lg>
                <l n="1" xml:id="kock-0487-epidikazomenos-24-l1" xml:lang="grc">πρόχειρον ἐπὶ τὴν γλῶτταν εὐλόγῳ τρέχειν</l>
              </lg>
              <note type="source">Stobaeus Floril. 13, 11 <foreign xml:lang="grc">Φιλήμονος Ἐπιδικαζομένου</foreign> A.</note>
              <note type="apparatus">constructio verborum sententiae non integrae admodum ambigua.</note>
            </div>
