  <text xml:base="urn:cts:greekLit:tlg0487.stratiotes.kock1884-grc1" xml:lang="grc"><body n="urn:cts:greekLit:tlg0487.stratiotes.kock1884-grc1" xml:lang="grc"><div type="edition" n="urn:cts:greekLit:tlg0487.stratiotes.kock1884-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0487_stratiotes"><head>ΣΤΡΑΤΙΩΤΗΣ</head><div type="textpart" subtype="fragment" n="79" xml:id="kock-0487-stratiotes-79" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0487_stratiotes">
              <lg>
                <l n="1" xml:id="kock-0487-stratiotes-79-l1" xml:lang="grc">ὡς ἵμερός μ’ ὑπῆλθε γῇ τε κοὐρανῷ</l>
                <l n="2" xml:id="kock-0487-stratiotes-79-l2" xml:lang="grc">λέξαι μολόντι τοὔψον ὡς ἐσκεύασα.</l>
                <l n="3" xml:id="kock-0487-stratiotes-79-l3" xml:lang="grc">νὴ τὴν Ἀθηνᾶν ἡδύ γ’ ἔστ’ εὐημερεῖν</l>
                <l n="4" xml:id="kock-0487-stratiotes-79-l4" xml:lang="grc">ἐν ἅπασιν· ἰχθὺς ἁπαλὸς οἷος γέγονέ μοι,</l>
                <l n="5" xml:id="kock-0487-stratiotes-79-l5" xml:lang="grc">οἷον παρατέθεικ’, οὐ πεφαρμακευμένον</l>
                <l n="6" xml:id="kock-0487-stratiotes-79-l6" xml:lang="grc">τυροῖσιν, οὐδ’ ἄνωθεν ἐξανθισμένον,</l>
                <l n="7" xml:id="kock-0487-stratiotes-79-l7" xml:lang="grc">ἀλλ’ οἷος ἦν ζῶν, κὠπτὸς ὢν τοιοῦτος ἦν·</l>
                <l n="8" xml:id="kock-0487-stratiotes-79-l8" xml:lang="grc">οὕτως ἁπαλὸν ἔδωκα καὶ πρᾶον τὸ πῦρ</l>
                <l n="9" xml:id="kock-0487-stratiotes-79-l9" xml:lang="grc">ὀπτῶν τὸν ἰχθύν, οὐδὲ πιστευθήσομαι.</l>
                <l n="10" xml:id="kock-0487-stratiotes-79-l10" xml:lang="grc">ὅμοιον ἐγένετ’, ὄρνις ὁπόταν ἁρπάσῃ</l>
                <l n="11" xml:id="kock-0487-stratiotes-79-l11" xml:lang="grc">τοῦ καταπιεῖν μεῖζόν τι· περιτρέχει κύκλῳ</l>
                <l n="12" xml:id="kock-0487-stratiotes-79-l12" xml:lang="grc">τηροῦσα τοῦτο, καταπιεῖν δ’ ἐσπούδακεν,</l>
                <l n="13" xml:id="kock-0487-stratiotes-79-l13" xml:lang="grc">ἕτεραι διώκουσιν δὲ ταύτην. ταὐτὸν ἦν.</l>
                <l n="14" xml:id="kock-0487-stratiotes-79-l14" xml:lang="grc">τὴν ἡδονὴν ὁ πρῶτος αὐτῶν καταμαθὼν</l>
                <l n="15" xml:id="kock-0487-stratiotes-79-l15" xml:lang="grc">τῆς λοπάδος, ἀνεπήδησε κἄφευγεν κύκλῳ</l>
                <l n="16" xml:id="kock-0487-stratiotes-79-l16" xml:lang="grc">τὴν λοπάδ’ ἔχων, ἄλλοι δ’ ἐδίωκον κατὰ πόδας.</l>
                <l n="17" xml:id="kock-0487-stratiotes-79-l17" xml:lang="grc">ἐξῆν ὀλολύζειν· οἱ μὲν ἤρπασάν τι γάρ,</l>
                <l n="18" xml:id="kock-0487-stratiotes-79-l18" xml:lang="grc">οἱ δ’ οὐδέν, οἱ δὲ πάντα. καίτοι παρέλαβον</l>
                <l n="19" xml:id="kock-0487-stratiotes-79-l19" xml:lang="grc">ἰχθῦς ποταμίους ἐσθίοντας βόρβορον·</l>
                <l n="20" xml:id="kock-0487-stratiotes-79-l20" xml:lang="grc">εἰ δ’ ἔλαβον ἄρτι σκάρον, ἢ ’κ τῆς Ἀττικῆς</l>
                <l n="21" xml:id="kock-0487-stratiotes-79-l21" xml:lang="grc">γλαυκίσκον, ὦ Ζεῦ σῶτερ, ἢ ’ξ Ἄργους κάπρον,</l>
                <l n="22" xml:id="kock-0487-stratiotes-79-l22" xml:lang="grc">ἢ ’κ τῆς Σικυῶνος τῆς φίλης ὃν τοῖς θεοῖς</l>
                <l n="23" xml:id="kock-0487-stratiotes-79-l23" xml:lang="grc">φέρει Ποσειδῶν γόγγρον εἰς τὸν οὐρανόν,</l>
                <l n="24" xml:id="kock-0487-stratiotes-79-l24" xml:lang="grc">ἅπαντες οἱ φαγόντες ἐγένοντ’ ἂν θεοί.</l>
                <l n="25" xml:id="kock-0487-stratiotes-79-l25" xml:lang="grc">ἀθανασίαν εὕρηκα· τοὺς ἤδη νεκρούς,</l>
                <l n="26" xml:id="kock-0487-stratiotes-79-l26" xml:lang="grc">ὅταν ὀσφρανθῶσι, ποιῶ ζῆν πάλιν.</l>
              </lg>
