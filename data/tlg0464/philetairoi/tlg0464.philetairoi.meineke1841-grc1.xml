      <div type="edition" n="urn:cts:greekLit:tlg0464.philetairoi.meineke1841-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0464_philetairoi">
        <head>ΦΙΛΕΤΑΙΡΟΙ</head>
        <div type="textpart" subtype="fragment" n="1" xml:id="meineke-0464-philetairoi-1">
          <lg>
            <l n="1" xml:id="meineke-0464-philetairoi-1-l1">Ἐπίκουρος ὁ σοφὸς ἀξιώσαντός τινος</l>
            <l n="2" xml:id="meineke-0464-philetairoi-1-l2">εἰπεῖν πρὸς αὐτὸν ὅ τι ποτ᾽ ἐστὶ τἀγαθόν,</l>
            <l n="3" xml:id="meineke-0464-philetairoi-1-l3">ὃ διὰ τέλους ζητοῦσιν, εἶπεν ἡδονήν.</l>
            <l n="4" xml:id="meineke-0464-philetairoi-1-l4">εὖ γ᾽, ὦ κράτιστ᾽ ἄνθρωπε καὶ σοφώτατε·</l>
            <l n="5" xml:id="meineke-0464-philetairoi-1-l5">τοῦ γὰρ μασᾶσθαι κρεῖττον οὐκ ἔστ᾽ οὐδὲ ἕν</l>
            <l n="6" xml:id="meineke-0464-philetairoi-1-l6">ἀγαθόν· πρόσεστιν ἡδονῇ γὰρ τἀγαθόν.</l>
          </lg>
          <note type="source">Athenaeus VII p. 279 d: <quote>Ἡγήσιππος δ᾽ ἐν Φιλεταίροις Ἐπίκουρος κτλ.</quote>
          </note>
          <note type="apparatus">Vs. 6 ἡδονῇ Schweighaeuserus. Vulgo ἡδονήν.</note>
        </div>
        <div type="textpart" subtype="fragment" n="unnumbered" ana="#compiled-unnumbered-fragment" xml:id="meineke-0464-philetairoi-unnumbered">
          <lg>
            <l n="1" xml:id="meineke-0464-philetairoi-unnumbered-l1">Epicurus ille sapiens, cum quis quaereret</l>
            <l n="2" xml:id="meineke-0464-philetairoi-unnumbered-l2">ab eo, quod illud esset eximium bonum,</l>
          </lg>
        </div>
      </div>
    </body>
