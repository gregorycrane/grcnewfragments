    <body xml:base="urn:cts:greekLit:tlg0085.oplon_krisis.dindorf1893-grc1"><div type="edition" n="urn:cts:greekLit:tlg0085.oplon_krisis.dindorf1893-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:oplon_krisis"><head>ΟΠΛΩΝ ΚΡΙΣΙΣ</head>
          <pb n="603" facs="urn:hathi:iau.31858007086675:scan:611"/>
          <div type="textpart" subtype="fragment" n="161" xml:id="frag_6166e9e8ef" corresp="urn:cite2:perseus:fragmentaryplays.v1:oplon_krisis" sameAs="urn:cts:greekLit:tlg0085.oplon_krisis.nauck1889-grc1:175">
            <note type="source">Scholiasta Sophoclis Ajacis v. 190. Αἰσχύλος ἐν Ὅπλων κρίσει</note>
            <lg type="fragment">
              <l n="1" xml:id="frag_6166e9e8ef-l1" xml:lang="grc">Ἀλλ' Ἀντικλείας ἆσσον ἦλθε Σίσυφος,</l>
              <l n="2" xml:id="frag_6166e9e8ef-l2" xml:lang="grc">τῆς σῆς λέγω τοι μητρὸς, ἤ σ' ἐγείνατο.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="162" xml:id="frag_33d959c41a" corresp="urn:cite2:perseus:fragmentaryplays.v1:oplon_krisis" sameAs="urn:cts:greekLit:tlg0085.oplon_krisis.nauck1889-grc1:176">
            <note type="source">Stobæus XI, 8. Αἰσχύλου Ὅπλων κρίσεως</note>
            <lg type="fragment">
              <l n="1" xml:id="frag_33d959c41a-l1" xml:lang="grc">Ἁπλᾶ γάρ ἐστι τῆς ἀληθείας ἔπη.</l>
            </lg>
          </div>
          <div type="textpart" subtype="fragment" n="163" xml:id="frag_52b3c72483" corresp="urn:cite2:perseus:fragmentaryplays.v1:oplon_krisis" sameAs="urn:cts:greekLit:tlg0085.oplon_krisis.nauck1889-grc1:177">
            <note type="source">Stobæus CXXI, 23. Αἰσχύλου ἐν Ο. κ.</note>
            <lg type="fragment">
              <l n="1" xml:id="frag_52b3c72483-l1" xml:lang="grc">Τί γὰρ καλὸν ζῆν βίοτον ὃς λύπας φέρει;</l>
            </lg>
            <note type="apparatus">βίοτον Stanleius. Libri βίον.</note>
          </div>
          <div type="textpart" subtype="fragment" n="164" xml:id="frag_2682aab07f" corresp="urn:cite2:perseus:fragmentaryplays.v1:oplon_krisis" sameAs="urn:cts:greekLit:tlg0085.oplon_krisis.nauck1889-grc1:174">
            <note type="source">Aristophanes Acharn. v. 883. Πρέσβειρα πεντήκοντα Κωπάδων κορᾶν. ubi scholiasta, Ὁ στίχος ἀπὸ δράματος Αἰσχύλου Ὅπλων κρίσεως οὕτως ἐπιγεγραμμένου, ἐν ᾧ ἐπικαλεῖται τὰς Νηρηίδας τις ἐξελθοῦσας πρὸς τὴν Θέτιν λέγων</note>
            <lg type="fragment">
              <l n="1" xml:id="frag_2682aab07f-l1" xml:lang="grc">Δέσποινα πεντήκοντα Νηρήδων κορῶν.</l>
            </lg>
            <note type="apparatus">κορῶν Bentleius. κορᾶν cod. Navν. χορόν. Ald.</note>
          </div>
        </div></body></text>
