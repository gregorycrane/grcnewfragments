    <body n="urn:cts:greekLit:tlg0432.korinthioi.meineke1841-grc1" xml:lang="grc">
      <div type="edition" n="urn:cts:greekLit:tlg0432.korinthioi.meineke1841-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0432_korinthioi">
        <head>ΚΟΡΙΝΘΙΟΙ</head>
        <div type="textpart" subtype="fragment" n="unnumbered" ana="#compiled-unnumbered-fragment" xml:id="meineke-0432-korinthioi-unnumbered">
          <lg>
            <l n="1" xml:id="meineke-0432-korinthioi-unnumbered-l1">Εἰ τοῖς μεθυσκομένοις ἑκάστης ἡμέρας</l>
            <l n="2" xml:id="meineke-0432-korinthioi-unnumbered-l2">ἀλγεῖν συνέβαινε τὴν κεφαλὴν πρὸ τοῦ πιεῖν</l>
            <l n="3" xml:id="meineke-0432-korinthioi-unnumbered-l3">τὸν ἄκρατον ἡμῶν, οὐδὲ εἷς ἔπινεν ἄν.</l>
            <l n="4" xml:id="meineke-0432-korinthioi-unnumbered-l4">νυνὶ δὲ πρότερον τοῦ πόνου τὴν ἡδονήν</l>
            <l n="5" xml:id="meineke-0432-korinthioi-unnumbered-l5">προλαμβάνοντες ὑστεροῦμεν τἀγαθοῦ.</l>
          </lg>
          <note type="source">
            <bibl>Athenaeus XIV p. 613 b:</bibl> Κλέαρχός τε ὁ κωμῳδιοποιὸς ἐν Κορινθίοις φησί <quote>Εἰ τοῖς κτλ.</quote>
          </note>
          <note type="apparatus">Simillimam Alexidis sententiam vide vol. III p. 500. Vs. 4 libri νῦν δὲ πρότερόν γε. Correxit Porsonus Advers. p. 50.</note>
          <lg>
            <l n="1_2" xml:id="meineke-0432-korinthioi-unnumbered-l1_2">Hominibus si vinosis semper pridie</l>
            <l n="2_2" xml:id="meineke-0432-korinthioi-unnumbered-l2_2">caput doleret antequam biberent merum,</l>
            <l n="3_2" xml:id="meineke-0432-korinthioi-unnumbered-l3_2">nemo esset nostrûm deditus temulentiae.</l>
            <l n="4_2" xml:id="meineke-0432-korinthioi-unnumbered-l4_2">nunc ante dolorem praecipientes gaudia</l>
            <l n="5_2" xml:id="meineke-0432-korinthioi-unnumbered-l5_2">a concupito mox bono relinquimur.</l>
          </lg>
        </div>
      </div>
    </body>
