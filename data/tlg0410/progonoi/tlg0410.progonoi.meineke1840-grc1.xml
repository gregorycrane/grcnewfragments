  <text xml:base="urn:cts:greekLit:tlg0410.progonoi.meineke1840-grc1" xml:lang="grc"><body n="urn:cts:greekLit:tlg0410.progonoi.meineke1840-grc1" xml:lang="grc"><div type="edition" n="urn:cts:greekLit:tlg0410.progonoi.meineke1840-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0410_progonoi"><head>ΠΡΟΓΟΝΟΙ</head><div type="textpart" subtype="fragment" n="1" xml:id="meineke-0410-progonoi-1">
              <lg>
                <l n="1" xml:id="meineke-0410-progonoi-1-l1">Τὸν τρόπον μὲν οἶσθά μου</l>
                <l n="2" xml:id="meineke-0410-progonoi-1-l2">ὅτι τῦφος οὐκ ἔνεστιν, ἀλλὰ τοῖς φίλοις</l>
                <l n="3" xml:id="meineke-0410-progonoi-1-l3">τοιοῦτοσί τίς εἰμι, τύπτεσθαι μύδρος,</l>
                <l n="4" xml:id="meineke-0410-progonoi-1-l4">τύπτειν κεραυνός, ἐκτυφλοῦν τιν᾿ ἀστραπή,</l>
                <l n="5" xml:id="meineke-0410-progonoi-1-l5">φέρειν τιν᾿ ἄραντ᾽ ἄνεμος, ἀποπνῖξαι βρόχος,</l>
                <l n="6" xml:id="meineke-0410-progonoi-1-l6">θύρας μοχλεύειν σεισμός, εἰσπηδᾶν ἀκρίς,</l>
              </lg>
            </div>
            <pb n="660" facs="urn:hathi:hvd.32044079388682:scan:662" />
            <div type="textpart" subtype="fragment" n="1_2" ana="#compiled-duplicate-number #compiled-citation-normalized" xml:id="meineke-0410-progonoi-1_2">
              <lg>
                <l n="1" xml:id="meineke-0410-progonoi-1_2-l1">imposuit: sed ego nil moror dicteria,</l>
                <l n="2" xml:id="meineke-0410-progonoi-1_2-l2">amicus amicis reapse, non dictis modo.</l>
              </lg>
              <pb n="660" facs="urn:hathi:hvd.32044079388682:scan:662" />
              <lg>
                <l n="3" xml:id="meineke-0410-progonoi-1_2-l3">nihil est certum, stabile nihil est usquam, nisi quod in diem</l>
                <l n="4" xml:id="meineke-0410-progonoi-1_2-l4">quisque genio gratum faciens sibimet ipse impenderit.</l>
                <l n="5" xml:id="meineke-0410-progonoi-1_2-l5">sed nec hoc securum satis est: facile namque everterit</l>
                <l n="6" xml:id="meineke-0410-progonoi-1_2-l6">aliquis mensam bene paratam. sed cum iam mansas dapes</l>
                <l n="7" xml:id="meineke-0410-progonoi-1_2-l7">perque dentium transmissas septa deglutiveris,</l>
                <l n="8" xml:id="meineke-0410-progonoi-1_2-l8">id demum tibi putato positum esse extra omnem aleam.</l>
              </lg>
            </div>
          </div></body></text></TEI>