  <text xml:base="urn:cts:greekLit:tlg0458.pamphilos.kock1884-grc1" xml:lang="grc"><body n="urn:cts:greekLit:tlg0458.pamphilos.kock1884-grc1" xml:lang="grc"><div type="edition" n="urn:cts:greekLit:tlg0458.pamphilos.kock1884-grc1" xml:lang="grc" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0458_pamphilos"><head>ΠΑΜΦΙΛΟΣ</head><div type="textpart" subtype="fragment" n="80_81_82" xml:id="kock-0458-pamphilos-80_81_82" corresp="urn:cite2:perseus:fragmentaryplays.v1:tlg0458_pamphilos">
              <lg>
                <l n="1" xml:id="kock-0458-pamphilos-80_81_82-l1" xml:lang="grc">ἐγὼ δέ, καὶ γὰρ ἔτυχεν ὂν κατ’ ἀντικρὺ</l>
                <l n="2" xml:id="kock-0458-pamphilos-80_81_82-l2" xml:lang="grc">τῆς οἰκίας καινὸν καπηλεῖον μέγα,</l>
                <l n="3" xml:id="kock-0458-pamphilos-80_81_82-l3" xml:lang="grc">ἐνταῦθ’ ἐπετήρουν τὴν τροφὸν τῆς παρθένου</l>
                <l n="4" xml:id="kock-0458-pamphilos-80_81_82-l4" xml:lang="grc">κεράσαι κελεύσας τὸν κάπηλόν μοι χόα</l>
                <l n="5" xml:id="kock-0458-pamphilos-80_81_82-l5" xml:lang="grc">ὀβολοῦ, παραθεῖναί θ’ ὡς μέγιστον κάνθαρον</l>
                <l n="6" xml:id="kock-0458-pamphilos-80_81_82-l6" xml:lang="grc">ὁ δὲ κάνθαρος πάλαι κενὸς ὡς ξηραίνεται</l>
                <l n="7" xml:id="kock-0458-pamphilos-80_81_82-l7" xml:lang="grc">ἅμα δὲ λαβοῦσ’ ἠφάνικε πηλίκον τινὰ</l>
              </lg>
            </div>
